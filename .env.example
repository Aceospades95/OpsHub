DATABASE_URL="postgresql://user:password@localhost:5432/opshub?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google SSO (optional — leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email driver (optional — defaults to "log" which writes EmailLog rows
# only; nothing leaves the box). Set to "smtp" to send via SMTP, "ses"
# to send via AWS SES. EMAIL_FROM is required for any non-log driver
# and must match a verified sender on the chosen provider.
EMAIL_DRIVER="log"
EMAIL_FROM="noreply@example.com"

# SMTP driver (only required when EMAIL_DRIVER="smtp"). The same env
# vars work for local Unraid testing as for AWS production — the
# driver is environment-agnostic. For Google Workspace SMTP, use:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=<workspace-mailbox>@your-domain.com
#   SMTP_PASSWORD=<google-workspace-app-password>
# Note: SMTP_USER and EMAIL_FROM must match the same mailbox or
# Gmail rejects the envelope.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@example.com"
SMTP_PASSWORD=""
