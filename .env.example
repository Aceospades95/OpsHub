DATABASE_URL="postgresql://user:password@localhost:5432/opshub?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google SSO (optional — leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email driver (optional — defaults to "log" which writes to EmailLog only)
# Set to "smtp" to send via SMTP, "ses" to send via AWS SES.
EMAIL_DRIVER="log"
EMAIL_FROM="noreply@example.com"

# SMTP driver (only required when EMAIL_DRIVER="smtp")
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@example.com"
SMTP_PASSWORD=""
