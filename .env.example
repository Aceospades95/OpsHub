# ─── Required (every environment) ──────────────────────────────────────

# Postgres connection string. The role must be able to CREATE TABLE
# (so prisma migrate deploy can run on container boot).
DATABASE_URL="postgresql://user:password@localhost:5432/opshub?schema=public"

# Public URL the app is reachable at. Must match what users hit in
# their browser exactly (scheme + host + port). NextAuth uses this
# to construct callback URLs for OAuth.
NEXTAUTH_URL="http://localhost:3000"

# Random secret used to sign NextAuth session JWTs. Must be at least
# 32 characters. Generate a fresh one with:
#   openssl rand -base64 32
# DO NOT commit this. Each environment (dev / staging / prod) gets
# its own.
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# ─── Required in production ────────────────────────────────────────────

# Shared secret protecting POST /api/jobs/run. Without it, all
# scheduled jobs (contract reminders, daily digests, workflow ticking,
# import + email maintenance) silently never fire because every cron
# call returns 401. Generate with:
#   openssl rand -hex 32
# Configure your cron provider (EventBridge, Vercel Cron, GitHub
# Actions schedule, OS cron + curl) to POST /api/jobs/run hourly with
# this value in the `x-cron-secret` header.
CRON_SECRET=""

# Days to keep ActivityLog rows before the weekly cleanup job deletes
# them. Default 365. Set higher if your compliance window is longer.
ACTIVITY_LOG_RETENTION_DAYS="365"

# Days to keep JobLog rows. Default 90. JobLog grows fast (≈1 row per
# minute from workflows-tick alone) so the window is shorter than the
# other audit logs by default.
JOB_LOG_RETENTION_DAYS="90"

# Days to keep WorkflowEvent rows for terminal (COMPLETED/CANCELLED)
# instances. Default 365. In-flight instances always keep their full
# event timeline regardless of age.
WORKFLOW_EVENT_RETENTION_DAYS="365"

# Two-stage retention for EmailLog. Bodies are scrubbed (nulled) after
# EMAIL_LOG_BODY_RETENTION_DAYS so long-retained metadata stays useful
# for audit without retaining message content. The whole row is hard-
# deleted after EMAIL_LOG_RETENTION_DAYS.
EMAIL_LOG_BODY_RETENTION_DAYS="30"
EMAIL_LOG_RETENTION_DAYS="365"

# ─── Email ─────────────────────────────────────────────────────────────

# Email driver — one of:
#   log  — writes EmailLog rows only; nothing leaves the box (dev / test)
#   ses  — AWS SES via the v2 API
#   smtp — generic SMTP via nodemailer (Gmail / Workspace / your own MTA)
#
# Production MUST NOT use 'log' — every customer-facing email would
# silently drop. The boot-time validator rejects EMAIL_DRIVER=log when
# NODE_ENV=production unless you opt in explicitly with
# ALLOW_LOG_DRIVER_IN_PROD=true.
EMAIL_DRIVER="log"

# Sender address. Must be a verified identity on the chosen driver
# (SES verified sender, SMTP user mailbox).
EMAIL_FROM="noreply@example.com"

# SES driver (only required when EMAIL_DRIVER="ses"). Credentials come
# from the AWS SDK default chain — IAM roles in prod, ~/.aws/credentials
# locally — the driver does not read AWS_ACCESS_KEY_ID directly.
SES_REGION=""

# SMTP driver (only required when EMAIL_DRIVER="smtp"). For Google
# Workspace SMTP:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=<workspace-mailbox>@your-domain.com
#   SMTP_PASSWORD=<google-workspace-app-password>
# SMTP_USER and EMAIL_FROM must match the same mailbox or Gmail
# rejects the envelope.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""

# ─── File storage ──────────────────────────────────────────────────────

# Storage driver:
#   local — filesystem under STORAGE_LOCAL_DIR (dev / single-node)
#   s3    — AWS S3 (or S3-compatible via S3_ENDPOINT)
#
# Production should use s3 — container filesystems are ephemeral and
# uploads land on disk that disappears on every deploy.
STORAGE_DRIVER="local"

# Local driver: where files land. Must NOT be inside the Next.js
# public/ directory. Default is `${cwd}/.storage/files`.
STORAGE_LOCAL_DIR=""

# Per-user soft cap on total stored bytes. Default 1 GiB (1073741824).
# Set to a lower value to tighten cost controls; set to 0 to disable
# the check entirely (e.g. internal tooling where every user is trusted
# and you have separate billing-side cost controls).
USER_STORAGE_QUOTA_BYTES="1073741824"

# S3 driver (only required when STORAGE_DRIVER="s3"). Credentials use
# the AWS SDK default chain — the driver does not read
# AWS_ACCESS_KEY_ID directly.
S3_BUCKET=""
S3_REGION=""
# Optional: override endpoint URL for S3-compatible services
# (MinIO, LocalStack). When set, the driver uses path-style addressing.
S3_ENDPOINT=""

# ─── Google SSO (optional) ─────────────────────────────────────────────

# Both must be set together to enable Google sign-in. When unset,
# users can only sign in with email/password.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── One-off scripts ───────────────────────────────────────────────────

# Email of the user to promote to ADMIN when running:
#   npm run promote:admin
# Used once per deployment to bootstrap the first admin (the seed
# script was deliberately removed for security).
PROMOTE_ADMIN_EMAIL=""
