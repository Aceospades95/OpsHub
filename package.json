    "@types/bcryptjs": "^2.4.6",
    "@types/d3": "^7.4.3",
    "@types/d3-org-chart": "^3.1.2",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.23",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.22",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
