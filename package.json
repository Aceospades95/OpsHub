{
  "name": "opshub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "node -e \"if(process.env.NODE_ENV==='production'){console.error('db:push is disabled in production. Use prisma migrate deploy instead — db:push bypasses the migration history and creates the failed-migration drift that hit Unraid in v1.');process.exit(1)}\" && prisma db push",
    "validate:env": "node scripts/validate-env.mjs",
    "promote:admin": "npx tsx prisma/promote-admin.ts",
    "seed:workflows": "npx tsx prisma/seed-workflow-defaults.ts",
    "merge:duplicate-users": "npx tsx prisma/merge-duplicate-users.ts",
    "merge:users-by-id": "npx tsx prisma/merge-users-by-id.ts",
    "merge:jacob-wright": "npx tsx prisma/merge-jacob-wright.ts",
    "backfill:quote-numbers": "npx tsx prisma/backfill-quote-numbers.ts",
    "dedupe:intranet-org-chart": "npx tsx prisma/dedupe-intranet-org-chart.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/client-sesv2": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@prisma/client": "^6.2.1",
    "@react-pdf/renderer": "^4.5.1",
    "@tiptap/extension-color": "^3.22.4",
    "@tiptap/extension-mention": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-text-style": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@types/react-grid-layout": "^1.3.6",
    "bcryptjs": "^2.4.3",
    "d3": "^7.9.0",
    "d3-org-chart": "^3.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "lucide-react": "^0.469.0",
    "next": "^14.2.22",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^7.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3",
    "zod": "^3.24.1"
