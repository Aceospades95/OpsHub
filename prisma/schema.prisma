// ─── CERTIFICATIONS ────────────────────────────────────

model Certification {
  id                   String              @id @default(cuid())
  name                 String
  description          String?             @db.Text
  plainEnglishSummary  String?             @db.Text // Layman explanation of what this cert is
  certNumber           String?
  status               CertificationStatus @default(PENDING)
  type                 CertificationType   @default(OTHER)
  engagementType       CertEngagementType  @default(CERTIFICATION)
  jurisdictionLevel    JurisdictionLevel   @default(OTHER)
  jurisdictionName     String? // e.g. "Illinois", "Cook County"
  issuingBody          String? // Who issued it (e.g., "ISO", "OSHA")
  agencyWebsiteUrl     String? // Link to the issuing body's website
  agencyContactName    String?
  agencyContactEmail   String?
  agencyContactPhone   String?
  issuedDate           DateTime?
  submittedDate        DateTime? // When the application was submitted
  /// Set when the renewal application has been submitted and the org is
  /// waiting on the issuing body. While set: the expiry-reminder job
  /// skips this cert and list views show "Renewal submitted" instead of
  /// expiring/expired alarms. Cleared on sign-off (new cycle) or
  /// manually from the cert detail page.
  renewalSubmittedAt   DateTime?
  expirationDate       DateTime?
  renewalDate          DateTime? // When to start renewal process
  renewalLeadDays      Int?                @default(90) // Legacy single lead — kept for back-compat
  reminderOffsetsDays  Int[]               @default([90, 30, 7]) // Multi-tier reminder offsets
  firedReminderOffsets Int[]               @default([]) // Offsets already fired for the current cycle
  autoRenew            Boolean             @default(false)
  renewalCost          Float?
  currency             String?             @default("USD")
  renewalRequirements  String?             @db.Text // What's needed for renewal
  renewalNotes         String?             @db.Text
  documentUrl          String? // Link to cert document (legacy)
  completedCertUrl     String? // Link to the finished/issued certificate
  clientId             String?
  assigneeId           String? // Person currently owning the renewal task
  pointOfContactId     String? // Long-term internal owner (separate from assignee)
  signedOffAt          DateTime?
  signedOffById        String?
  signOffNotes         String?             @db.Text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt            DateTime?

  client         Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee       User?   @relation("CertificationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  pointOfContact User?   @relation("CertificationPointOfContact", fields: [pointOfContactId], references: [id], onDelete: SetNull)
  signedOffBy    User?   @relation("CertificationSignedOffBy", fields: [signedOffById], references: [id], onDelete: SetNull)

  files          File[]
  comments       Comment[]
  links          ExternalLink[]
  embeds         Embed[]
  checklistItems CertificationRenewalChecklistItem[]
  renewalHistory CertificationRenewalHistory[]
}

model CertificationRenewalChecklistItem {
  id              String    @id @default(cuid())
  certificationId String
  label           String
  required        Boolean   @default(false)
  completed       Boolean   @default(false)
  completedAt     DateTime?
  completedById   String?
  sortOrder       Int       @default(0)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  completedBy   User?         @relation("ChecklistItemCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([certificationId, sortOrder])
}

model CertificationRenewalHistory {
  id              String    @id @default(cuid())
  certificationId String
  cycleStart      DateTime?
  cycleEnd        DateTime?
  issuedDate      DateTime?
  expiredDate     DateTime?
  signedOffById   String?
  signedOffAt     DateTime?
  cost            Float?
  currency        String?   @default("USD")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  signedOffBy   User?         @relation("RenewalHistorySignedOffBy", fields: [signedOffById], references: [id], onDelete: SetNull)

  @@index([certificationId, createdAt])
}

// ─── SERVICE OFFERINGS ─────────────────────────────────

model ServiceOffering {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments Assignment[]
  projects    Project[]
}

// ─── ROLE DEFINITIONS ─────────────────────────────────

model RoleDefinition {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectRoles ProjectRole[]
  assignments  Assignment[]
}

// ─── PROJECT ROLES (Staffing Requirements) ───────────

model ProjectRole {
  id               String   @id @default(cuid())
  projectId        String
  roleDefinitionId String
  requiredFte      Float    @default(1.0)
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleDefinition RoleDefinition @relation(fields: [roleDefinitionId], references: [id])
  assignments    Assignment[]

  @@index([projectId])
  @@index([roleDefinitionId])
}

// ─── ASSIGNMENTS / ALLOCATIONS ─────────────────────────

enum AssignmentStatus {
  ACTIVE
  PLANNED
  COMPLETED
  ON_HOLD
}

model Assignment {
  id                String           @id @default(cuid())
  employeeId        String
  projectId         String?
  clientId          String?
  serviceOfferingId String?
  projectRoleId     String?
  roleDefinitionId  String?
  function          String? // work type / functional area
  role              String? // legacy freeform role — prefer roleDefinition
  allocationFte     Float            @default(0)
  status            AssignmentStatus @default(ACTIVE)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  employee        User             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  serviceOffering ServiceOffering? @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)
  projectRole     ProjectRole?     @relation(fields: [projectRoleId], references: [id], onDelete: SetNull)
  roleDefinition  RoleDefinition?  @relation(fields: [roleDefinitionId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([projectId])
  @@index([clientId])
  @@index([serviceOfferingId])
  @@index([projectRoleId])
  @@index([roleDefinitionId])
  @@index([status])
}

// ─── DATA IMPORTS ──────────────────────────────────────
//
// Audit log for CSV imports through src/lib/importers/. Each row records
// one import run — what was uploaded, who did it, how many rows were
// created vs skipped, and any per-row error messages.

model ImportLog {
  id          String   @id @default(cuid())
  importerKey String // matches a key in the importer registry
  filename    String
  rowCount    Int // total parsed rows
  imported    Int // successfully created (new rows only)
  /// Rows that matched an existing record and were updated in place
  /// when the import ran in upsert mode. Defaults to 0 for legacy rows
  /// and for create-only imports.
  updated     Int      @default(0)
  skipped     Int // skipped (duplicates, dry-run, etc.)
  /// Rows that failed validation / FK resolution and were not written.
  /// Derived arithmetically for legacy rows (rowCount - imported -
  /// updated - skipped); stored explicitly from 2026-07 on.
  failed      Int      @default(0)
  /// Rows written WITH warnings (dropped foreign key, coerced enum, …).
  /// Subset of imported+updated, not an additional bucket.
  warnings    Int      @default(0)
  /**
   * JSON array of { row, status, message } entries for every non-clean
   * row (failed / skipped / warning). Updated rows without warnings are
   * NOT recorded here (pre-2026-07 blobs included them).
   */
  errors      String?  @db.Text
  triggeredBy String // user id
  createdAt   DateTime @default(now())

  @@index([importerKey, createdAt])
  @@index([createdAt])
  @@index([triggeredBy])
}

// ─── SCHEDULED JOBS ────────────────────────────────────
//
// Audit log for scheduled job runs. Each row records one execution of a
// job defined in src/lib/jobs/. Jobs can be triggered by the cron endpoint
// (/api/jobs/run) or manually from /admin/jobs.

model JobLog {
  id          String    @id @default(cuid())
  jobKey      String // matches a key in the job registry
  status      String // "running" | "completed" | "failed"
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  /**
   * Free-form summary string the job handler returns
   */
  output      String?   @db.Text
  /**
   * Stack/message when status = "failed"
   */
  error       String?   @db.Text
  /**
   * Number of items the job processed (for at-a-glance metrics)
   */
  processed   Int?
  /**
   * "cron" for scheduled runs, or a user id for manual runs
   */
  triggeredBy String

  @@index([jobKey, startedAt])
  @@index([startedAt])
  @@index([status])
}

// ─── JOB CONFIG ────────────────────────────────────────
//
// Per-jobKey settings — currently just isEnabled. System jobs are
// code-defined (see src/lib/jobs/registry.ts) so we don't store
// definitions here, only operator-controlled toggles. A row is created
// lazily the first time an admin disables/enables a job.
model JobConfig {
  jobKey    String   @id
  isEnabled Boolean  @default(true)
  /// Typed per-job parameters (JSON object). Each JobDefinition declares
  /// a paramsSchema describing its knobs (due windows, escalation
  /// thresholds, …); /admin/jobs/[jobKey] renders a form from it and
  /// handlers read merged values via getJobParams(). Null = code defaults.
  params    Json?
  /// Optional cadence override. When null the job uses its code-defined
  /// cadence (the gate in lib/jobs/gating.ts checks shouldRunDaily /
  /// shouldRunWeekly / shouldRunMonthly directly). When set, the same
  /// gate honors this value instead. Lets an admin tighten or relax a
  /// job's cadence without a code deploy.
  ///
  /// "DISABLED" lets an admin permanently skip the cadence gate while
  /// keeping isEnabled=true (useful when paired with manual "Run now"
  /// triggers from /admin/jobs).
  cadence   String?
  updatedAt DateTime @updatedAt
}

// ─── WORK LOGS ──────────────────────────────────────────
//
// Daily technician work logs (replaces the Google Form + reminder
// sheet). One row per user per workday; duplicate submissions UPDATE
// the day instead of double-counting. Reminder logic lives in the
// work-log-reminders job and is exceptions-aware: PTO/sick/holiday
// days (ScheduleException) count as satisfied, so nobody gets nagged
// from a sick bed.

model WorkLog {
  id          String   @id @default(cuid())
  userId      String
  /// The calendar day being reported (UTC-midnight date, one per user).
  workDate    DateTime
  hours       Float
  /// Tickets / sites worked — free text like "PHLF014 Service call".
  sites       String?  @db.Text
  notes       String?  @db.Text
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([workDate])
}

enum ScheduleExceptionType {
  PTO
  SICK
  HOLIDAY
  UNPAID
  OTHER
}

/// A day range on which work logs are NOT expected. userId null =
/// org-wide (company holiday). The reminder job treats excepted days
/// as satisfied; the team view shows them instead of "missing".
model ScheduleException {
  id          String                @id @default(cuid())
  /// Null = applies to everyone (holiday).
  userId      String?
  startDate   DateTime
  endDate     DateTime
  type        ScheduleExceptionType
  /// Unapproved exceptions still suppress reminders (the person is out
  /// either way) but are flagged in the team view for follow-up.
  approved    Boolean               @default(true)
  notes       String?
  createdById String
  createdAt   DateTime              @default(now())

  user      User? @relation("ScheduleExceptionUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User  @relation("ScheduleExceptionCreator", fields: [createdById], references: [id])

  @@index([userId, startDate])
  @@index([startDate])
}

/// Frozen Monday-morning snapshot of the prior week, per person — the
/// "frozen vs live delta" audit trick from the spreadsheet this module
/// replaces. Live edits after the snapshot remain visible as a delta.
model WorkLogWeekSnapshot {
  id            String   @id @default(cuid())
  /// ISO week key, e.g. "2026-W28".
  weekKey       String
  userId        String
  expectedDays  Int
  submittedDays Int
  totalHours    Float
  snapshotAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([weekKey, userId])
  @@index([weekKey])
}

/// Live per-person-per-week flags — currently overtime approval, so
/// approved OT stops looking like unapproved OT in the rollups.
model WorkWeekFlag {
  id                String   @id @default(cuid())
  userId            String
  /// ISO week key, e.g. "2026-W28".
  weekKey           String
  overtimeApproved  Boolean  @default(false)
  approvedById      String?
  note              String?
  updatedAt         DateTime @updatedAt

  user       User  @relation("WorkWeekFlagUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("WorkWeekFlagApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([userId, weekKey])
  @@index([weekKey])
}

/// Per-user notification mutes, honored by the engine per channel.
/// Absence of a row = receive everything (stock behavior).
model UserNotificationPref {
  id        String   @id @default(cuid())
  userId    String
  /// Matches a NOTIFICATION_TYPE_REGISTRY key.
  typeKey   String
  muteInApp Boolean  @default(false)
  muteEmail Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, typeKey])
}

/// Per-notification-type delivery rule — the admin-editable layer the
/// notification engine (src/lib/notifications) consults on every
/// notify() call. ABSENCE of a row = code defaults (enabled, both
/// channels, caller-supplied recipients only), so rollout is
/// incremental and deleting a rule restores stock behavior.
model NotificationRule {
  id              String   @id @default(cuid())
  /// Matches a key in NOTIFICATION_TYPE_REGISTRY ("task-assigned", …).
  typeKey         String   @unique
  /// Master kill switch: false = neither in-app rows nor emails.
  enabled         Boolean  @default(true)
  channelInApp    Boolean  @default(true)
  channelEmail    Boolean  @default(true)
  /// Roles whose active users are ADDED to the caller's recipients.
  recipientRoles  String[] @default([])
  /// Specific user ids ADDED to the caller's recipients.
  recipientUserIds String[] @default([])
  /// Raw external addresses that get their own copy of the email.
  extraEmails     String[] @default([])
  /// Optional overrides applied to the outgoing EMAIL (not the in-app
  /// row). {{variable}} placeholders substitute from the per-type
  /// variable map documented in the registry.
  subjectTemplate String?
  bodyTemplate    String?  @db.Text
  /// Suppress repeat sends of the same type for the same entity within
  /// N hours (null = no throttling). In-app and email both suppressed.
  throttleHours   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── NOTIFICATIONS ─────────────────────────────────────
//
// In-app notification for a user. Written by src/lib/notifications/notify().
// Optionally paired with an outbound email — that's handled by notify()
// itself which delegates to the email layer after writing the row.

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  /**
   * Free-form type key for filtering/grouping — see NotificationType in code
   */
  type        String
  title       String
  body        String?   @db.Text
  /**
   * Where clicking the notification should navigate
   */
  href        String?
  /**
   * Optional entity this notification is about, for context and routing
   */
  entityType  String?
  entityId    String?
  /**
   * Who triggered this (null for system notifications)
   */
  actorId     String?
  /**
   * Read timestamp — null means unread
   */
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([entityType, entityId])
  @@index([type])
}

// ─── EMAIL LOG ─────────────────────────────────────────
//
// Every outbound email routed through src/lib/email/ lands here for audit
// and debugging. In dev the "log" driver ONLY writes to this table and
// doesn't actually send, so it's safe to test templates without spamming.

model EmailLog {
  id           String   @id @default(cuid())
  toAddresses  String // comma-separated recipient list
  ccAddresses  String? // comma-separated CC recipients
  bccAddresses String? // comma-separated BCC recipients
  replyTo      String?
  fromAddress  String
  subject      String
  bodyHtml     String   @db.Text
  bodyText     String?  @db.Text
  driver       String // which driver handled send: "log", "resend", etc
  status       String // "sent" | "failed" | "queued"
  messageId    String? // provider's message ID when available
  error        String?  @db.Text
  templateKey  String? // which template was used
  entityType   String? // optional audit: entity this email is about
  entityId     String?
  sentAt       DateTime @default(now())

  @@index([sentAt])
  @@index([status])
  @@index([templateKey])
  @@index([entityType, entityId])
}

// ─── CUSTOM WIDGETS ────────────────────────────────────

model CustomWidget {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  config      String   @db.Text // JSON WidgetConfig
  icon        String?  @default("BarChart3")
  category    String   @default("data")
  isPublished Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([isPublished])
}

// ─── SSO ALLOWED DOMAINS ──────────────────────────────
//
// Admin-managed allowlist of email domains permitted to sign in
// via Google SSO. If no rows exist, all Google domains are allowed.

model AllowedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique // e.g. "company.com"
  createdAt DateTime @default(now())
}

// ─── ACCESS REQUESTS ─────────────────────────────────────

model AccessRequest {
  id          String    @id @default(cuid())
  requesterId String
  module      String?
  entityType  String?
  entityId    String?
  entityLabel String?
  status      String    @default("PENDING") // PENDING, APPROVED, DENIED
  reviewerId  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  requester User  @relation("AccessRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("AccessRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requesterId])
}

// ─── GOOGLE TASKS INTEGRATION ────────────────────────────
//
// Per-user link to the Google Tasks API. One row per connected user (in
// practice: the owner). Created by the OAuth flow at
// /api/integrations/google-tasks/connect; consumed by the
// google-tasks-sync job (src/lib/jobs/jobs/google-tasks-sync.ts) and the
// /my inbox. Deliberately separate from the NextAuth `Account` row: a
// credentials-login user can connect Google Tasks without having Google
// SSO linked, and disconnecting the integration must not touch sign-in.
//
// The refresh token is long-lived; short-lived access tokens are minted
// from it on demand and cached with their expiry so a sync pass doesn't
// re-mint needlessly. `tasklistId` pins the Google task list the sync
// mirrors (an "OpsHub" list is created on first sync when unset).

model GoogleTasksIntegration {
  id                   String    @id @default(cuid())
  userId               String    @unique
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  /// Google tasklist id the sync mirrors. Null until the first sync
  /// creates/locates the "OpsHub" list.
  tasklistId           String?
  /// High-water mark for incremental pulls (Google `updatedMin`).
  lastSyncedAt         DateTime?
  /// When the last FULL pull (no updatedMin window) completed cleanly.
  /// Null forces the next sync to walk every task once — used to
  /// backfill fields added after rows were first pulled (sourceLink,
  /// sourceReadOnly), since incremental pulls never revisit unchanged
  /// tasks. Reset to null to re-run a backfill after adding a field.
  fullPulledAt         DateTime?
  lastSyncStatus       String? // "success" | "failed"
  lastSyncError        String?   @db.Text
  /// Client-side auto-sync cadence while /my is open. Null / 0 = off.
  autoSyncMinutes      Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── QUOTES ─────────────────────────────────────────────
//
// Sales quote / proposal builder. A Quote belongs to a Client and optionally
// to a Project. Line items can be reusable CatalogItem references or one-off
// custom rows. Quotes can be revised — a revision links back to the parent
// via parentQuoteId and the parent transitions to REVISED.
//
// Phase 1 covers: draft authoring, line items, totals, templates, catalog.
// Phases 2+ wire up sending, public token view, accept/reject, e-sig, PDF.

model Quote {
  id                    String            @id @default(cuid())
  /// Human-readable identifier auto-generated on create (e.g. "Q-2026-0001").
  /// Unique across the org. Format is fixed; renumbering would invalidate
  /// the URL the client received in their email.
  quoteNumber           String            @unique
  clientId              String
  projectId             String?
  status                QuoteStatus       @default(DRAFT)
  title                 String
  /// Markdown-friendly intro text rendered above the line items on the
  /// public view. Optional.
  introText             String?           @db.Text
  /// Project assumptions / scope clarifications rendered between the
  /// line items and the totals on the public view. Lets the author
  /// list out "this quote assumes X, Y, Z" so the client knows what's
  /// been factored in. Optional.
  assumptionsText       String?           @db.Text
  /// Footer / terms & conditions text rendered below the totals on the
  /// public view. Optional.
  termsText             String?           @db.Text
  currency              String            @default("USD")
  /// Cached subtotal of all line items (after per-line discounts, before
  /// quote-level discount and tax). Recomputed on every save.
  subtotal              Float             @default(0)
  discountType          QuoteDiscountType @default(NONE)
  discountValue         Float             @default(0)
  /// Tax rate as a percentage. Nullable so tax-exempt quotes can render
  /// cleanly without a 0% line on the public view.
  taxRate               Float?
  taxAmount             Float             @default(0)
  total                 Float             @default(0)
  validUntil            DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  sentAt                DateTime?
  firstViewedAt         DateTime?
  acceptedSignatureName String?
  acceptedSignatureData String?           @db.Text
  acceptedIp            String?
  rejectionReason       String?           @db.Text
  /// Links a revision to the prior version. The parent transitions to
  /// REVISED when a child is created.
  parentQuoteId         String?
  createdById           String
  assignedToId          String?
  /// Owner-only notes — never rendered on the client-facing public view.
  internalNotes         String?           @db.Text
  /// Cryptographically random token used in the public share URL `/q/:token`.
  /// Set when the quote is first sent. Nullable on drafts.
  publicToken           String?           @unique
  /// File reference to the most recently generated PDF. Regenerated on
  /// edit so consumers can rely on `pdfFile.url` being current.
  pdfFileId             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt             DateTime?

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentQuote Quote?   @relation("QuoteRevisions", fields: [parentQuoteId], references: [id])
  revisions   Quote[]  @relation("QuoteRevisions")
  createdBy   User     @relation("QuoteCreator", fields: [createdById], references: [id])
  assignedTo  User?    @relation("QuoteAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  pdfFile     File?    @relation("QuotePdf", fields: [pdfFileId], references: [id], onDelete: SetNull)

  lineItems QuoteLineItem[]
  events    QuoteEvent[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([validUntil])
}

model QuoteLineItem {
  id                String                  @id @default(cuid())
  quoteId           String
  position          Int                     @default(0)
  /// Optional grouping label rendered as a section divider on the public
  /// view (e.g. "Hardware", "Services", "Optional Add-ons").
  groupLabel        String?
  /// When true, the client can toggle this row on/off on the public quote
  /// page. The total recalculates as they toggle.
  isOptional        Boolean                 @default(false)
  /// Whether this optional row is currently selected. Always true for
  /// non-optional rows. The client mutates this on accept.
  isSelected        Boolean                 @default(true)
  catalogItemId     String?
  name              String
  description       String?                 @db.Text
  quantity          Float                   @default(1)
  unit              String?
  unitPrice         Float                   @default(0)
  discountType      QuoteDiscountType       @default(NONE)
  discountValue     Float                   @default(0)
  isRecurring       Boolean                 @default(false)
  recurringInterval QuoteRecurringInterval?
  /// Cached row subtotal (qty * unitPrice, after this row's discount).
  subtotal          Float                   @default(0)

  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([quoteId, position])
}

// Reusable service / product catalog. Powers line-item autocomplete in the
// quote editor — typing in a row's name field pulls suggestions from here.
// Catalog items are global; per-line edits don't write back to the catalog.
model CatalogItem {
  id               String   @id @default(cuid())
  name             String
  description      String?  @db.Text
  defaultUnitPrice Float    @default(0)
  defaultUnit      String?
  category         String?
  isRecurring      Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quoteLineItems    QuoteLineItem[]
  templateLineItems QuoteTemplateLineItem[]

  @@index([isActive])
  @@index([category])
}

// Saved quote shapes used as the starting point for new quotes. A template
// has the same shape as a Quote minus per-quote fields (client, dates,
// signatures, etc.). Creating a quote from a template clones the line items.
model QuoteTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  introText       String?  @db.Text
  assumptionsText String?  @db.Text
  termsText       String?  @db.Text
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User @relation("QuoteTemplateCreator", fields: [createdById], references: [id])

  lineItems QuoteTemplateLineItem[]
}

model QuoteTemplateLineItem {
  id                String                  @id @default(cuid())
  templateId        String
  position          Int                     @default(0)
  groupLabel        String?
  isOptional        Boolean                 @default(false)
  catalogItemId     String?
  name              String
  description       String?                 @db.Text
  quantity          Float                   @default(1)
  unit              String?
  unitPrice         Float                   @default(0)
  discountType      QuoteDiscountType       @default(NONE)
  discountValue     Float                   @default(0)
  isRecurring       Boolean                 @default(false)
  recurringInterval QuoteRecurringInterval?

  template    QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([templateId, position])
}

// Audit / activity log for a single quote. Distinct from the global
// ActivityLog because public actors (clients viewing/accepting) are not
// User rows and we want richer per-event metadata.
model QuoteEvent {
  id        String   @id @default(cuid())
  quoteId   String
  /// One of: created, sent, viewed, downloaded, accepted, rejected,
  /// revised, edited, comment_added. Stored as a string so adding a new
  /// event type doesn't require a migration.
  eventType String
  /// "user" | "client" | "system"
  actorType String
  /// User id when actorType="user". Null for client and system actors.
  actorId   String?
  /// Free-form JSON payload for event-specific data.
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

// ─── WORKFLOWS ──────────────────────────────────────────
//
// Generic workflow engine for sequential automations like Employee
// Onboarding, Offboarding, and Candidate Hiring. A WorkflowTemplate is
// the blueprint; a WorkflowInstance is a single in-flight execution
// attached to a subject (employee, candidate, or other entity).
//
// Phase 3 covers the data model + template builder. Phase 4 wires the
// scheduled background worker that ticks instances forward. Phase 5
// adds the self-service portal that subjects use to fill out forms,
// upload documents, and sign agreements.

model WorkflowTemplate {
  id                String              @id @default(cuid())
  name              String
  description       String?             @db.Text
  type              WorkflowType        @default(CUSTOM)
  /// What kind of subject this workflow operates on. Drives which
  /// trigger options are available and which variable paths the
  /// template editor offers in the autocomplete.
  subjectEntityType WorkflowSubjectType @default(EMPLOYEE)
  isActive          Boolean             @default(true)
  /// True for the seeded defaults (Onboarding/Offboarding/Candidate)
  /// the migration ships with. The UI hides delete on these so users
  /// don't accidentally drop a system template.
  isSeed            Boolean             @default(false)
  createdById       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  createdBy User               @relation("WorkflowTemplateCreator", fields: [createdById], references: [id])
  steps     WorkflowStep[]
  instances WorkflowInstance[]
  triggers  WorkflowTrigger[]

  @@index([type])
  @@index([isActive])
}

model WorkflowStep {
  id                 String             @id @default(cuid())
  workflowTemplateId String
  /// 1-based ordering within the template. The editor renders steps
  /// in `position` order; reordering is a position rewrite.
  position           Int                @default(0)
  name               String
  stepType           WorkflowStepType
  /// Step-type-specific config blob — see src/lib/workflows/step-types.ts
  /// for the discriminated union the UI and engine share.
  config             String             @db.Text
  timingType         WorkflowTimingType @default(ON_ENTRY)
  /// When timingType is DAYS_AFTER_START / DAYS_BEFORE_TARGET this is
  /// the offset in days. When AFTER_STEP, this field is unused and
  /// `afterStepId` holds the dependency. ON_ENTRY ignores it.
  timingValue        Int                @default(0)
  afterStepId        String?
  isRequired         Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  afterStep        WorkflowStep?    @relation("StepOrder", fields: [afterStepId], references: [id])
  followingSteps   WorkflowStep[]   @relation("StepOrder")

  instanceSteps WorkflowInstanceStep[]

  @@index([workflowTemplateId, position])
  @@index([afterStepId])
}

model WorkflowInstance {
  id                 String                 @id @default(cuid())
  workflowTemplateId String
  /// Polymorphic FK — subjectId points at a User (when subjectType is
  /// EMPLOYEE) or a free-form id (CUSTOM). No DB-level FK because the
  /// type varies; the engine resolves the subject in code.
  subjectType        WorkflowSubjectType
  subjectId          String
  status             WorkflowInstanceStatus @default(PENDING)
  startDate          DateTime
  /// Optional target date — required for offboarding and any timing
  /// rule that uses DAYS_BEFORE_TARGET.
  targetDate         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdById        String
  /// JSON snapshot of the subject at instance-start time. The engine
  /// uses this for variable substitution so renames after kickoff
  /// don't retroactively change emails that already went out.
  context            String?                @db.Text
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  workflowTemplate WorkflowTemplate       @relation(fields: [workflowTemplateId], references: [id])
  createdBy        User                   @relation("WorkflowInstanceCreator", fields: [createdById], references: [id])
  steps            WorkflowInstanceStep[]
  events           WorkflowEvent[]

  @@index([workflowTemplateId])
  @@index([subjectType, subjectId])
  @@index([status])
  @@index([startDate])
}

model WorkflowInstanceStep {
  id                 String                     @id @default(cuid())
  workflowInstanceId String
  workflowStepId     String
  status             WorkflowInstanceStepStatus @default(PENDING)
  scheduledFor       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  completedByUserId  String?
  /// Step-type-specific output: form responses, uploaded file ids,
  /// signature ids, approval decisions.
  output             String?                    @db.Text
  /// Last failure message — surfaced in the admin "stuck workflows"
  /// view so retries can be diagnosed.
  error              String?                    @db.Text
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowStep     WorkflowStep     @relation(fields: [workflowStepId], references: [id])
  completedByUser  User?            @relation("WorkflowInstanceStepCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  documents  WorkflowDocument[]
  signatures WorkflowSignature[]

  @@index([workflowInstanceId])
  @@index([workflowStepId])
  @@index([scheduledFor, status])
  /// Powers the watchdog sweep in lib/workflows/engine.ts that reverts
  /// stuck IN_PROGRESS synchronous steps after a worker crash.
  @@index([status, startedAt])
}

/// Reusable email body with `{{path.to.field}}` variable substitution.
/// Distinct from src/lib/email/templates.ts (typed code-defined templates
/// for transactional system emails) — these are USER-EDITABLE templates
/// that workflow steps reference by id.
model WorkflowEmailTemplate {
  id                 String   @id @default(cuid())
  name               String
  subject            String
  bodyHtml           String   @db.Text
  bodyText           String?  @db.Text
  /// JSON array of variable paths suggested by the editor's
  /// autocomplete, e.g. ["subject.firstName", "company.name"].
  availableVariables String?  @db.Text
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdBy User? @relation("WorkflowEmailTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([name])
}

model WorkflowDocument {
  id                     String   @id @default(cuid())
  workflowInstanceStepId String
  fileId                 String
  uploadedAt             DateTime @default(now())

  workflowInstanceStep WorkflowInstanceStep @relation(fields: [workflowInstanceStepId], references: [id], onDelete: Cascade)
  file                 File                 @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([workflowInstanceStepId])
}

model WorkflowSignature {
  id                     String   @id @default(cuid())
  workflowInstanceStepId String
  signedName             String
  signatureData          String?  @db.Text
  signedIp               String?
  /// Snapshot of the document text the subject saw at sign time so
  /// later edits to the request_signature step config don't change
  /// what's been signed already.
  documentTextSnapshot   String?  @db.Text
  signedAt               DateTime @default(now())

  workflowInstanceStep WorkflowInstanceStep @relation(fields: [workflowInstanceStepId], references: [id], onDelete: Cascade)

  @@index([workflowInstanceStepId])
}

/// Single durable token per subject for portal access. Kept distinct
/// from per-action tokens (like quote tokens) because portals are
/// long-lived: a new hire fills out forms over multiple sessions and
/// shouldn't have to request a new link each time.
model PortalToken {
  id          String              @id @default(cuid())
  subjectType WorkflowSubjectType
  subjectId   String
  token       String              @unique
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  /// Set when an admin revokes the link. A revoked token resolves
  /// exactly like an expired one (same null result — no oracle), so a
  /// leaked link dies immediately instead of riding out its 90-day
  /// expiry. The engine's mint path skips revoked rows and rotates in
  /// a fresh token, so revoking + starting a new instance (or
  /// reissuing) yields a new link while the old one stays dead.
  revokedAt   DateTime?
  createdAt   DateTime            @default(now())

  @@unique([subjectType, subjectId])
}

model WorkflowEvent {
  id                 String   @id @default(cuid())
  workflowInstanceId String
  eventType          String
  /// "user" | "subject" | "system"
  actorType          String
  actorId            String?
  metadata           String?  @db.Text
  createdAt          DateTime @default(now())

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  @@index([workflowInstanceId, createdAt])
}

/// Trigger config for a workflow template — what causes a new instance
/// to spawn automatically. Manual instances don't need a trigger row.
/// One template can have many triggers (e.g. fire on user create AND
/// 7 days before termination).
model WorkflowTrigger {
  id                 String              @id @default(cuid())
  workflowTemplateId String
  triggerType        WorkflowTriggerType
  /// Type-specific JSON config:
  ///  ENTITY_CREATE  → { entityType: "User", filter?: {...} }
  ///  SCHEDULED_DATE → { dateField: "terminationDate", offsetDays: -7 }
  ///  STAGE_CHANGE   → { stageField: "stage", targetValue: "offer_accepted" }
  config             String              @db.Text
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  @@index([workflowTemplateId])
  @@index([triggerType, isActive])
}

// (Candidate model removed — hiring now flows through workflow
//  triggers on User creation and project assignment. The
//  WorkflowSubjectType enum no longer offers CANDIDATE.)

// ─── SCHEDULED TASKS ────────────────────────────────────────
//
// Admin-built recurring jobs. Distinct from src/lib/jobs/ which holds
// code-defined system jobs (contract expiry, certification expiry,
// etc.) — those ship as part of the build. Scheduled tasks are
// data-driven so non-developers can wire up things like "email the
// project-status report to the leadership group every Monday at 9 AM"
// from the admin UI.
//
// The runner — `custom-scheduled-tasks` in src/lib/jobs/jobs/ —
// wakes up hourly via cron, finds rows whose next run window has
// arrived, and dispatches each to its handler.

enum ScheduledTaskFrequency {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum ScheduledTaskType {
  /// Render a registered report and email it to a recipient list.
  /// config: { reportKey: string, recipients: string[] }
  EMAIL_REPORT
  /// Send a static or lightly-templated message to a recipient list.
  /// config: { subject: string, body: string, recipients: string[] }
  EMAIL_MESSAGE
  /// Hard-delete rows whose deletedAt is older than the configured
  /// retention window. Recommended schedule: DAILY at off-peak hours.
  /// config: { retentionDays?: number } — defaults to 30.
  PURGE_SOFT_DELETED
}

model ScheduledTask {
  id            String                 @id @default(cuid())
  name          String
  description   String?                @db.Text
  taskType      ScheduledTaskType
  frequency     ScheduledTaskFrequency
  /// Hour of the day (UTC) the task should fire. 0-23. Honored by
  /// DAILY / WEEKLY / MONTHLY. HOURLY tasks ignore it.
  hourUtc       Int                    @default(9)
  /// 0=Sunday … 6=Saturday. Honored by WEEKLY only.
  dayOfWeek     Int?
  /// 1-28. Honored by MONTHLY only. Capped at 28 so every month has
  /// a valid trigger date — calendars with fewer days don't surprise.
  dayOfMonth    Int?
  /// Type-specific JSON config — see ScheduledTaskType comments above.
  config        String                 @db.Text
  isActive      Boolean                @default(true)
  /// When the task last fired. Drives idempotency in the runner —
  /// a task that already ran in the current window is skipped.
  lastRunAt     DateTime?
  /// "success" | "failed" — surfaces in the admin list as a colored
  /// badge so failing tasks are visible at a glance.
  lastRunStatus String?
  lastRunOutput String?                @db.Text
  lastRunError  String?                @db.Text
  createdById   String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  createdBy User @relation("ScheduledTaskCreator", fields: [createdById], references: [id])

  @@index([isActive, frequency])
  @@index([lastRunAt])
}

// ─── CUSTOM REPORTS ─────────────────────────────────────────
//
// Admin-built reports — distinct from src/lib/reports/ which holds
// code-defined system reports. Custom reports are data-driven so
// non-developers can compose "show me all active projects with their
// FTE total and client name" without writing TypeScript.
//
// The shape is intentionally constrained: pick a registered entity
// type, choose columns from the curated list for that entity, add
// filters from the curated list, and pick a sort. No free SQL, no
// arbitrary joins — admins should never be able to read tables they
// can't already see in the UI.

enum CustomReportEntity {
  USER
  PROJECT
  CLIENT
  QUOTE
  TASK
  CONTRACT
  CERTIFICATION
  ASSIGNMENT
  SUBCONTRACTOR
  PARTNERSHIP
}

model CustomReport {
  id          String             @id @default(cuid())
  name        String
  description String?            @db.Text
  /// Free-form grouping label rendered on /admin/reports. Lets admins
  /// organize custom reports the same way system reports group by
  /// module. Null = "Uncategorized" bucket.
  category    String?
  entityType  CustomReportEntity
  /// JSON array of column keys from the entity's registry. Order is
  /// the order they appear in the rendered table + CSV.
  columns     String             @db.Text
  /// JSON array of { field, op, value } filter clauses. AND-combined.
  filters     String             @db.Text
  /// Column key to sort by, prefixed with "-" for descending.
  /// E.g. "name", "-createdAt".
  sortBy      String?
  /// Hard cap on rows returned. Null = use the registry default
  /// (typically 500). Useful for emailed digests where you only want
  /// the top N.
  limit       Int?
  isActive    Boolean            @default(true)
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy User @relation("CustomReportCreator", fields: [createdById], references: [id])

  @@index([entityType])
  @@index([isActive])
  @@index([category])
}

// ─── SUBCONTRACTORS ────────────────────────────────────────
//
// External parties (1099 individuals, sub firms, staffing agencies) that
// perform billable project work on our behalf. Distinct from Supplier
// (vendor selling goods/services TO the company) and from User (internal
// employee). Subcontractors don't get login access; they're tracked
// purely for engagement, compliance, and reporting.
//
// Compliance fields (insuranceExpiresAt, w9OnFile, msaSignedAt,
// ndaSignedAt, complianceStatus) drive a future scheduled report that
// surfaces lapsing insurance / missing W-9s before they block billing.

model Subcontractor {
  id          String              @id @default(cuid())
  name        String
  /// Legal entity name as it appears on contracts. Often differs from the
  /// public-facing `name` (e.g. dba). Null when the same as `name`.
  legalName   String?
  type        SubcontractorType   @default(COMPANY)
  status      SubcontractorStatus @default(ACTIVE)
  description String?             @db.Text
  summary     String?             @db.Text
  /// Free-form skill/service tags used for matching subs to project
  /// needs. Indexed by hand at the UI layer (no GIN index here yet).
  specialties String[]            @default([])

  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  website             String?
  address             String? @db.Text

  /// Tax identifier (EIN or SSN). Stored as plain text intentionally —
  /// matches the existing pattern for Client / Supplier data; encrypt at
  /// a later phase across all PII columns rather than ad-hoc here.
  taxId           String?
  businessLicense String?

  /// Default rate when assigned to a project. Per-project overrides live
  /// on `SubcontractorProject.rate`.
  defaultRate  Float?
  rateUnit     String? // "hour" | "day" | "project" | "fixed"
  currency     String? @default("USD")
  paymentTerms String? // "Net 30" etc.

  insuranceExpiresAt DateTime?
  w9OnFile           Boolean          @default(false)
  msaSignedAt        DateTime?
  ndaSignedAt        DateTime?
  complianceStatus   ComplianceStatus @default(PENDING)
  complianceNotes    String?          @db.Text

  rating      Float? // 1-5
  isPreferred Boolean @default(false)

  accountManagerId String? // internal owner
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt        DateTime?

  accountManager User?                  @relation("SubcontractorAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  contacts       SubcontractorContact[]
  projects       SubcontractorProject[]
  files          File[]
  links          ExternalLink[]
  comments       Comment[]

  @@index([status])
  @@index([type])
  @@index([accountManagerId])
  @@index([isPreferred])
  @@index([complianceStatus])
  @@index([insuranceExpiresAt])
}

model SubcontractorContact {
  id              String   @id @default(cuid())
  subcontractorId String
  name            String
  title           String?
  email           String?
  phone           String?
  isPrimary       Boolean  @default(false)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@index([subcontractorId])
}

/// Engagement of a Subcontractor on a Project — captures the commercial
/// terms (scope, value, dates, status) so the project page rolls up
/// subcontractor cost and the subcontractor page lists active engagements.
/// Independent of the staffing matrix (`Assignment`) which only tracks
/// internal employees by FTE.
model SubcontractorProject {
  id              String                        @id @default(cuid())
  subcontractorId String
  projectId       String
  scope           String?                       @db.Text // SOW summary
  role            String? // "Lead Developer", "QA Lead"
  status          SubcontractorAssignmentStatus @default(ACTIVE)
  startDate       DateTime?
  endDate         DateTime?
  contractValue   Float?
  currency        String?                       @default("USD")
  rate            Float?
  rateUnit        String?
  notes           String?                       @db.Text
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([subcontractorId, projectId])
  @@index([projectId])
  @@index([status])
}

// ─── PARTNERSHIPS ──────────────────────────────────────────
//
// Strategic relationships with other organizations — referrers,
// resellers, technology partners, channel partners, joint ventures.
// Distinct from Client (paying customer), Supplier (vendor), and
// Subcontractor (project labor). A partnership can also tag projects
// to record co-delivery or joint ownership.

model Partnership {
  id          String            @id @default(cuid())
  name        String
  legalName   String?
  type        PartnershipType   @default(STRATEGIC)
  status      PartnershipStatus @default(ACTIVE)
  tier        PartnershipTier?
  description String?           @db.Text
  summary     String?           @db.Text

  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  website             String?
  address             String? @db.Text
  industry            String?

  partnerSinceDate   DateTime?
  agreementSignedAt  DateTime?
  agreementExpiresAt DateTime?
  autoRenew          Boolean   @default(false)

  /// Plain-English description of the commercial terms (e.g. "20% on
  /// referred deals through year 1"). The structured `referralFeeBps`
  /// is provided as a separate optional field for reporting.
  revenueShareTerms String? @db.Text
  /// Referral fee in basis points (1/100 of a percent). 2000 = 20%.
  referralFeeBps    Int?
  jointMarketing    Boolean @default(false)

  relationshipOwnerId String?
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt           DateTime?

  relationshipOwner User? @relation("PartnershipOwner", fields: [relationshipOwnerId], references: [id], onDelete: SetNull)

  contacts PartnershipContact[]
  projects PartnershipProject[]
  files    File[]
  links    ExternalLink[]
  comments Comment[]

  @@index([status])
  @@index([type])
  @@index([tier])
  @@index([relationshipOwnerId])
  @@index([agreementExpiresAt])
}

model PartnershipContact {
  id            String   @id @default(cuid())
  partnershipId String
  name          String
  title         String?
  email         String?
  phone         String?
  isPrimary     Boolean  @default(false)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)

  @@index([partnershipId])
}

/// Tag-style link from a Partnership to a Project. The `role` field
/// tells the project page how the partner is involved (referred us
/// the deal, co-delivering with us, joint ownership of the engagement,
/// etc.) and powers the Partnership ROI report.
model PartnershipProject {
  id            String                 @id @default(cuid())
  partnershipId String
  projectId     String
  role          PartnershipProjectRole @default(OTHER)
  notes         String?                @db.Text
  /// When role = REFERRER, the deal value attributed to the partner.
  /// Drives the "referral revenue YTD" headline on the partner page.
  referralValue Float?
  currency      String?                @default("USD")
  createdAt     DateTime               @default(now())

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([partnershipId, projectId])
  @@index([projectId])
  @@index([role])
}

// ─── DISCIPLINARY ACTION REPORTS ──────────────────────────
//
// HR incident documentation, replacing the Google Spreadsheet template.
// Reports are created by ADMIN/MANAGER from the employee's profile and
// exported as a PDF (via /api/team/.../disciplinary/.../pdf) for the
// employee to sign. Sensitive: never visible to the field tier — every
// read/write path gates on ADMIN or MANAGER.

enum DisciplinaryActionType {
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  SUSPENSION
  TERMINATION
  OTHER
}

model DisciplinaryReport {
  id              String                 @id @default(cuid())
  employeeId      String
  issuedById      String
  actionType      DisciplinaryActionType @default(WRITTEN_WARNING)
  incidentDate    DateTime
  /// Factual account of what happened.
  description     String                 @db.Text
  /// Company response — the action being taken.
  actionTaken     String?                @db.Text
  /// Corrective expectations going forward.
  improvementPlan String?                @db.Text
  witnesses       String?
  followUpDate    DateTime?
  /// Set when the employee acknowledges receipt (matches the signature
  /// line on the exported PDF).
  acknowledgedAt  DateTime?
  notes           String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt       DateTime?

  /// Restrict, not Cascade: hard-deleting a user must never silently
  /// destroy the HR paper trail. deleteUser's P2003 catch turns the
  /// blocked delete into a "deactivate instead" message, and merge-users
  /// reassigns these rows — both paths preserve the records.
  employee User @relation("DisciplinaryEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  issuedBy User @relation("DisciplinaryIssuer", fields: [issuedById], references: [id])

  @@index([employeeId, incidentDate])
}

// ─── VEHICLE FLEET ────────────────────────────────────────
//
// Company vehicles + their maintenance history. The list page surfaces
// due/overdue service (from `nextServiceDate`); the daily
// vehicle-maintenance-check job notifies admins/managers when a vehicle
// enters its due window. `maintenanceNotifiedFor` dedupes the job — one
// notification per nextServiceDate value, re-armed whenever the date
// changes (i.e. after service is logged).

enum VehicleStatus {
  ACTIVE
  IN_SHOP
  RETIRED
  SOLD
}

model Vehicle {
  id                     String        @id @default(cuid())
  /// Optional friendly label ("Van #3"). Lists fall back to
  /// year + make + model when unset.
  nickname               String?
  make                   String
  model                  String
  year                   Int
  vin                    String?       @unique
  licensePlate           String?
  status                 VehicleStatus @default(ACTIVE)
  assignedToId           String?
  currentMileage         Int?
  /// Next scheduled service — drives the due-soon visuals and the
  /// maintenance job. Updated automatically when a maintenance record
  /// with a nextDueDate is logged.
  nextServiceDate        DateTime?
  nextServiceMileage     Int?
  /// Job-dedupe stamp — see the model comment.
  maintenanceNotifiedFor DateTime?
  /// When currentMileage was last reported (maintenance submission or
  /// manual odometer update) — staleness signal for mileage-based due
  /// estimates.
  mileageUpdatedAt       DateTime?
  /// Registration/plates expiry — tracked like a service schedule in
  /// the fleet spreadsheet this module replaces.
  registrationExpiresAt  DateTime?
  notes                  String?       @db.Text
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt              DateTime?

  assignedTo         User?                      @relation("VehicleAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  maintenanceRecords VehicleMaintenanceRecord[]
  serviceSchedules   VehicleServiceSchedule[]
  files              File[]

  @@index([status])
  @@index([assignedToId])
  @@index([nextServiceDate])
}

/// Recurring service plan for one vehicle × one service type ("Oil
/// Change every 3 months / 4,000 miles") — the per-service-type model
/// from the fleet spreadsheet's Service Overview sheet. Due is computed
/// from whichever bound (time since last service, miles since last
/// service vs Vehicle.currentMileage) trips first; either bound may be
/// null for time-only / mileage-only schedules.
model VehicleServiceSchedule {
  id                 String    @id @default(cuid())
  vehicleId          String
  /// Free-form but normalized service label ("Oil Change") — matches
  /// VehicleMaintenanceRecord.serviceType so a logged service re-arms
  /// its schedule row.
  serviceType        String
  everyMonths        Int?
  everyMiles         Int?
  lastServiceDate    DateTime?
  lastServiceMileage Int?
  /// Due-state the maintenance job last notified for (the computed due
  /// date at send time) — re-arms automatically when a logged service
  /// moves the schedule forward. Mirrors Vehicle.maintenanceNotifiedFor.
  notifiedForDueAt   DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, serviceType])
  @@index([vehicleId])
}

model VehicleMaintenanceRecord {
  id             String   @id @default(cuid())
  vehicleId      String
  serviceDate    DateTime
  /// "Oil change", "Brake pads", "Tire rotation", … free-form.
  serviceType    String
  odometer       Int?
  cost           Float?
  vendor         String?
  notes          String?  @db.Text
  /// When this kind of service is next due. Logging a record with this
  /// set also updates Vehicle.nextServiceDate.
  nextDueDate    DateTime?
  nextDueMileage Int?
  createdAt      DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, serviceDate])
}

// ─── BID PIPELINE ─────────────────────────────────────────
//
// Business development: the procurement portals we're registered on
// (where deals are found) and the opportunities we pursue through
// them. An opportunity moves IDENTIFIED → PREPARING → SUBMITTED →
// WON / LOST / NO_BID / STALE; winning one converts into a Project
// (BidOpportunity.projectId) so the pipeline hands off to delivery.

enum BidStatus {
  /// Found it — evaluating whether to pursue.
  IDENTIFIED
  /// Go decision made; response in progress.
  PREPARING
  /// Response submitted — waiting on the buyer.
  SUBMITTED
  WON
  LOST
  /// Deliberate pass after evaluation.
  NO_BID
  /// Died quietly — no award ever announced / opportunity evaporated.
  STALE
}

model BidPortal {
  id                   String    @id @default(cuid())
  name                 String
  url                  String?
  /// "City of Chicago", "Cook County", "State of Illinois", "Federal", …
  jurisdiction         String?
  /// The login identity used on the portal (an email or username —
  /// NEVER a password; credentials live in the password manager).
  accountIdentifier    String?
  /// Some registrations must be renewed periodically.
  registrationRenewsAt DateTime?
  isActive             Boolean   @default(true)
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  bids BidOpportunity[]
}

model BidOpportunity {
  id                 String    @id @default(cuid())
  title              String
  /// RFP/RFQ/IFB number as published by the buyer.
  solicitationNumber String?
  /// Issuing agency / buyer ("City of Chicago DoIT").
  agency             String?
  /// Deep link to the solicitation (usually on the portal).
  url                String?
  description        String?   @db.Text
  estimatedValue     Float?
  currency           String?   @default("USD")
  status             BidStatus @default(IDENTIFIED)
  /// Response-submission deadline.
  dueDate            DateTime?
  submittedAt        DateTime?
  /// When the outcome (WON/LOST/NO_BID/STALE) was recorded.
  decidedAt          DateTime?
  lossReason         String?
  notes              String?   @db.Text
  /// Dedupe stamp for the bid-due-check job — one notification per
  /// dueDate value; changing the date re-arms it (mirrors
  /// Vehicle.maintenanceNotifiedFor).
  dueNotifiedFor     DateTime?
  portalId           String?
  clientId           String?
  ownerId            String?
  /// Set when a WON bid is converted into a delivery project.
  projectId          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt          DateTime?

  portal   BidPortal? @relation(fields: [portalId], references: [id], onDelete: SetNull)
  client   Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner    User?      @relation("BidOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  project  Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments Comment[]
  files    File[]

  @@index([status])
  @@index([dueDate])
  @@index([portalId])
  @@index([ownerId])
  @@index([clientId])
}
