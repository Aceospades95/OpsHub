}

enum WorkflowTriggerType {
  /// Auto-start an instance whenever an entity is created — e.g. new
  /// User → onboarding workflow. Fires synchronously from the
  /// creating action, after the entity row commits.
  ENTITY_CREATE
  /// Auto-start N days before/after a date field on the subject — e.g.
  /// 7 days before User.terminationDate → offboarding. Evaluated by
  /// the scheduled tick worker.
  SCHEDULED_DATE
  /// Auto-start when a subject's stage field flips to a target value.
  /// Reserved for future stage-driven flows.
  STAGE_CHANGE
  /// Auto-start when a User is added to a project (via Assignment or
  /// ProjectMember). Fires synchronously from the assignment-creating
  /// action with the assigned User as the subject. The trigger config
  /// can optionally filter to a specific projectId or serviceOffering.
  PROJECT_ASSIGNMENT
}

// ─── USERS ───────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  hashedPassword   String?
  authProvider     String    @default("credentials") // "credentials" | "google"
  role             Role      @default(VIEWER)
  /// Non-null when the user's role was auto-promoted by being assigned to a
  /// project. Stores the role they had before promotion so they can be
  /// reverted if they lose all their assignments.
  promotedFromRole Role?
  avatar           String?
  isActive         Boolean   @default(true)
  hasLoginAccess   Boolean   @default(true)
  department       String?
  jobTitle         String?
  location         String?
  phone            String?
  managerId        String?
  /// Last day of employment. Null for active employees. Read by the
  /// SCHEDULED_DATE trigger evaluator to fire offboarding workflows
  /// at the right offset (e.g. 7 days before terminationDate).
  terminationDate  DateTime?
  /// OPT-IN work-log roster (mirrors the old sheet's Config tab).
  /// Only enrolled people are expected to submit daily logs, get
  /// reminders, appear in the team matrix, or count in escalations /
  /// snapshots. Default FALSE on purpose: launching the module must
  /// never nag the whole company (which is exactly what happened when
  /// the roster was "every active user").
  workLogRequired      Boolean   @default(false)
  /// When enrollment was switched on — days before this are never
  /// "missing", so enrolling someone mid-week doesn't retro-nag them.
  workLogRequiredSince DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  manager       User?  @relation("UserManager", fields: [managerId], references: [id])
  directReports User[] @relation("UserManager")

  projectMembers                 ProjectMember[]
  milestoneAssignments           MilestoneAssignee[]
  comments                       Comment[]
  activityLogs                   ActivityLog[]
  uploadedFiles                  File[]                              @relation("FileUploader")
  profileFiles                   File[]                              @relation("FileOwner")
  modulePermissions              ModulePermission[]
  entityPermissions              EntityPermission[]
  assignedTasks                  Task[]                              @relation("TaskAssignee")
  createdTasks                   Task[]                              @relation("TaskCreator")
  sandboxPages                   SandboxPage[]
  managedClients                 Client[]                            @relation("ClientAccountManager")
  managedSubcontractors          Subcontractor[]                     @relation("SubcontractorAccountManager")
  ownedPartnerships              Partnership[]                       @relation("PartnershipOwner")
  customWidgets                  CustomWidget[]
  assignedCerts                  Certification[]                     @relation("CertificationAssignee")
  pocCerts                       Certification[]                     @relation("CertificationPointOfContact")
  signedOffCerts                 Certification[]                     @relation("CertificationSignedOffBy")
  certChecklistCompletions       CertificationRenewalChecklistItem[] @relation("ChecklistItemCompletedBy")
  certRenewalHistorySignoffs     CertificationRenewalHistory[]       @relation("RenewalHistorySignedOffBy")
  assignments                    Assignment[]
  notificationsReceived          Notification[]                      @relation("NotificationRecipient")
  notificationsSent              Notification[]                      @relation("NotificationActor")
  accessRequestsMade             AccessRequest[]                     @relation("AccessRequestRequester")
  accessRequestsReviewed         AccessRequest[]                     @relation("AccessRequestReviewer")
  createdQuotes                  Quote[]                             @relation("QuoteCreator")
  assignedQuotes                 Quote[]                             @relation("QuoteAssignee")
  createdQuoteTemplates          QuoteTemplate[]                     @relation("QuoteTemplateCreator")
  createdWorkflowTemplates       WorkflowTemplate[]                  @relation("WorkflowTemplateCreator")
  createdWorkflowInstances       WorkflowInstance[]                  @relation("WorkflowInstanceCreator")
  completedWorkflowInstanceSteps WorkflowInstanceStep[]              @relation("WorkflowInstanceStepCompletedBy")
  createdWorkflowEmailTemplates  WorkflowEmailTemplate[]             @relation("WorkflowEmailTemplateCreator")
  createdScheduledTasks          ScheduledTask[]                     @relation("ScheduledTaskCreator")
  createdCustomReports           CustomReport[]                      @relation("CustomReportCreator")
  ownedProjects                  Project[]                           @relation("ProjectOwner")
  googleTasksIntegration         GoogleTasksIntegration?
  assignedVehicles               Vehicle[]                           @relation("VehicleAssignee")
  disciplinaryReports            DisciplinaryReport[]                @relation("DisciplinaryEmployee")
  issuedDisciplinaryReports      DisciplinaryReport[]                @relation("DisciplinaryIssuer")
  ownedBids                      BidOpportunity[]                    @relation("BidOwner")
  workLogs                       WorkLog[]
  scheduleExceptions             ScheduleException[]                 @relation("ScheduleExceptionUser")
  createdScheduleExceptions      ScheduleException[]                 @relation("ScheduleExceptionCreator")
  workLogSnapshots               WorkLogWeekSnapshot[]
  workWeekFlags                  WorkWeekFlag[]                      @relation("WorkWeekFlagUser")
  approvedWorkWeekFlags          WorkWeekFlag[]                      @relation("WorkWeekFlagApprover")
  notificationPrefs              UserNotificationPref[]
  accounts                       Account[]
  signupTokens                   SignupToken[]
}

// ─── SIGNUP / RESET TOKENS ─────────────────────────
//
// One-time tokens that let a newly-invited user (or an existing user
// who needs a password reset) set their own password. Replaces the
// legacy "admin types a plaintext password into the Add Employee
// form" flow surfaced by the QA stress test.
//
// We never store the raw token — only its SHA-256 hash. The user
// receives the raw 32-byte hex token in their /signup/[token] URL
// (in their email), and we look up by hash on the way back. A leaked
// database dump can't be used to forge invites.
//
// One token per user (userId is unique). Issuing a new token replaces
// the old one — re-sending an invite invalidates the previous link
// rather than leaving a pile of stale URLs. `kind` discriminates
// "invite" (first-time setup) vs "reset" (existing user resetting);
// the consume + set-password flow is identical, only the email copy
// differs.

model SignupToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  /// SHA-256 hex of the raw token. Lookup is O(1) on the unique index.
  tokenHash String    @unique
  /// "invite" for first-time setup, "reset" for password reset.
  kind      String    @default("invite")
  expiresAt DateTime
  /// Set when the user completes the signup form. Once set, the token
  /// is dead — re-validation returns "expired" so a stolen URL can't
  /// be replayed.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([usedAt])
}

// ─── ACCOUNTS ──────────────────────────────────────
//
// OAuth-provider linkage (currently just Google). One row per
// (provider, providerAccountId) pair; FK to User. Populated by the
// signIn callback so a pre-provisioned User row links to a Google
// identity on first SSO without creating a duplicate User. The
// (provider, providerAccountId) unique constraint prevents one Google
// identity from ever pointing to two Users.
//
// Token columns (refresh_token, access_token, etc.) follow the
// standard NextAuth Account shape so existing tooling that introspects
// the schema works unchanged. We don't currently rely on those fields
// because sessions are JWT-only.

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String // "oauth" | "credentials" — currently always "oauth"
  provider          String // "google", etc.
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model ModulePermission {
  id         String  @id @default(cuid())
  userId     String
  module     String // clients, projects, contracts, suppliers, tools, intranet, admin
  canView    Boolean @default(false)
  canEdit    Boolean @default(false)
  canCreate  Boolean @default(false)
  canDelete  Boolean @default(false)
  canComment Boolean @default(false)
  canUpload  Boolean @default(false)
  canManage  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model EntityPermission {
  id         String  @id @default(cuid())
  userId     String
  entityType String // client, project
  entityId   String
  canView    Boolean @default(false)
  canEdit    Boolean @default(false)
  canComment Boolean @default(false)
  canUpload  Boolean @default(false)
  canManage  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
}

// ─── TASKS ──────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int        @default(0)
  projectId   String?
  clientId    String?
  assigneeId  String?
  createdById String
  /// Source attribution for tasks created by the workflow engine. Lets
  /// the /tasks UI badge a row "from workflow" and link back to the
  /// instance step that produced it. Null for manually created tasks.
  /// Examples of `sourceType`: "workflow_step".
  sourceType  String?
  sourceId    String?
  /// External link carried from the source (e.g. the Gmail message a
  /// Google Task was created from). Surfaced on /my.
  sourceLink  String?
  /// True when the source system won't accept writes back (Google
  /// "assigned tasks" from Chat/Docs, and Gmail-linked tasks, 403 on
  /// PATCH). We still pull these, but never push — see google-tasks/sync.
  sourceReadOnly Boolean @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt   DateTime?

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User     @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId])
  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([sourceType, sourceId])
}

// ─── CLIENTS ─────────────────────────────────────────────

model Client {
  id               String       @id @default(cuid())
  name             String
  /// URL-friendly slug derived from `name` at create time. Used as
  /// the canonical href on /clients/<slug>; the cuid still resolves
  /// for backwards compat with existing bookmarks. See
  /// src/lib/slug.ts for generation + collision rules.
  slug             String?      @unique
  description      String?      @db.Text
  summary          String?      @db.Text
  industry         String?
  website          String?
  status           ClientStatus @default(ACTIVE)
  accountManagerId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt        DateTime?

  accountManager User?           @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  projects       Project[]
  contracts      Contract[]
  certifications Certification[]
  contacts       ClientContact[]
  comments       Comment[]
  tasks          Task[]
  sandboxPages   SandboxPage[]
  assignments    Assignment[]
  activityLogs   ActivityLog[]
  quotes         Quote[]
  bids           BidOpportunity[]
}

model ClientContact {
  id        String   @id @default(cuid())
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  notes     String?  @db.Text
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─── PROJECTS ────────────────────────────────────────────

model Project {
  id                String        @id @default(cuid())
  name              String
  /// URL-friendly slug derived from `name` at create time. Used as
  /// the canonical href on /projects/<slug>; the cuid still resolves
  /// for backwards compat. See src/lib/slug.ts for the rules.
  slug              String?       @unique
  description       String?       @db.Text
  status            ProjectStatus @default(PLANNING)
  /// Free-form running notes, editable inline from the /my all-projects
  /// table — the "where is this at" field that used to live in the
  /// owner's spreadsheet. Distinct from `description` (what the project
  /// IS); notes are what's happening right now.
  notes             String?       @db.Text
  startDate         DateTime?
  endDate           DateTime?
  clientId          String
  /// Internal owner — whose plate this project is on. Drives the
  /// "My projects" section of /my. Nullable: legacy rows have no owner
  /// until one is set.
  ownerId           String?
  parentProjectId   String?
  serviceOfferingId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  /// Soft-delete tombstone. When non-null the row is hidden from list
  /// views; the /admin/recovery page can restore (clear deletedAt) or
  /// permanently delete it. The PURGE_SOFT_DELETED scheduled task
  /// hard-deletes rows whose deletedAt is older than 30 days.
  deletedAt         DateTime?

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner           User?            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parentProject   Project?         @relation("ProjectHierarchy", fields: [parentProjectId], references: [id])
  childProjects   Project[]        @relation("ProjectHierarchy")
  serviceOffering ServiceOffering? @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)

  contracts    Contract[]
  documents    Document[]
  files        File[]
  comments     Comment[]
  members      ProjectMember[]
  milestones   Milestone[]
  links        ExternalLink[]
  embeds       Embed[]
  tools        ProjectTool[]
  tasks        Task[]
  sandboxPages SandboxPage[]

  sourceBids       BidOpportunity[]
  relations        ProjectRelation[]      @relation("ProjectRelations")
  relatedRelations ProjectRelation[]      @relation("RelatedProjectRelations")
  assignments      Assignment[]
  projectRoles     ProjectRole[]
  activityLogs     ActivityLog[]
  quotes           Quote[]
  suppliers        SupplierProject[]
  subcontractors   SubcontractorProject[]
  partnerships     PartnershipProject[]

  @@index([serviceOfferingId])
  @@index([ownerId])
}

model ProjectRelation {
  id               String   @id @default(cuid())
  projectId        String
  relatedProjectId String
  createdAt        DateTime @default(now())

  project        Project @relation("ProjectRelations", fields: [projectId], references: [id], onDelete: Cascade)
  relatedProject Project @relation("RelatedProjectRelations", fields: [relatedProjectId], references: [id], onDelete: Cascade)

  @@unique([projectId, relatedProjectId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      Role     @default(CONTRIBUTOR)
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees MilestoneAssignee[]
}

model MilestoneAssignee {
  id          String   @id @default(cuid())
  milestoneId String
  userId      String
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, userId])
}

// ─── CONTRACTS ───────────────────────────────────────────

model Contract {
  id                  String         @id @default(cuid())
  title               String
  description         String?        @db.Text
  status              ContractStatus @default(DRAFT)
  contractNumber      String?
  contractType        ContractType?
  value               Float?
  currency            String?        @default("USD")
  startDate           DateTime?
  endDate             DateTime?
  renewalDate         DateTime?
  noticePeriodDays    Int?
  autoRenew           Boolean        @default(false)
  summary             String?        @db.Text
  externalDocumentUrl String?
  documentSourceType  String? // upload, google_drive, external_url, other
  documentSourceLabel String?
  parentContractId    String?
  clientId            String
  projectId           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt           DateTime?

  parentContract Contract?  @relation("ContractHierarchy", fields: [parentContractId], references: [id])
  childContracts Contract[] @relation("ContractHierarchy")
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project?   @relation(fields: [projectId], references: [id])

  terms    ContractTerm[]
  files    File[]
  comments Comment[]
  links    ExternalLink[]
  embeds   Embed[]
}

model ContractTerm {
  id          String    @id @default(cuid())
  type        TermType  @default(OTHER)
  title       String
  description String    @db.Text
  priority    Priority? @default(MEDIUM)
  dueDate     DateTime?
  contractId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// ─── DOCUMENTS ───────────────────────────────────────────

model Document {
  id        String       @id @default(cuid())
  title     String
  content   String?      @db.Text
  type      DocumentType @default(OTHER)
  version   Int          @default(1)
  published Boolean      @default(false)
  projectId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt DateTime?

  project  Project?          @relation(fields: [projectId], references: [id])
  versions DocumentVersion[]
  files    File[]
  comments Comment[]
  embeds   Embed[]
}

model DocumentVersion {
  id         String   @id @default(cuid())
  version    Int
  content    String   @db.Text
  changelog  String?  @db.Text
  documentId String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ─── SUPPLIERS ───────────────────────────────────────────

model Supplier {
  id           String         @id @default(cuid())
  name         String
  category     String
  contactName  String?
  /// Job title of the primary contact ("Account Manager", "Dispatcher").
  contactTitle String?
  contactEmail String?
  contactPhone String?
  /// Short city/region label ("Chicago", "Cook County, IL") used for the
  /// grouped supplier list. Distinct from `address`, which is the full
  /// free-form mailing address.
  location     String?
  address      String?        @db.Text
  website      String?
  notes        String?        @db.Text
  status       SupplierStatus @default(ACTIVE)
  isPreferred  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  /// Soft-delete tombstone — see Project.deletedAt comment.
  deletedAt    DateTime?

  files    File[]
  links    ExternalLink[]
  comments Comment[]
  contacts SupplierContact[]
  projects SupplierProject[]
}

/// Additional supplier contacts beyond the flat primary-contact fields —
/// AP departments, dispatchers, personal vs company emails, fax lines.
/// One row per person/channel; same shape as SubcontractorContact.
model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model SupplierProject {
  id         String   @id @default(cuid())
  supplierId String
  projectId  String
  notes      String?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  /// The Project side of this join was a bare string column until July
  /// 2026 — no FK, so hard-deleting a project (recovery-bin purge)
  /// orphaned these rows and Project couldn't include its suppliers.
  /// The migration removes existing orphans before adding the constraint.
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([supplierId, projectId])
  @@index([projectId])
}

// ─── TOOLS ───────────────────────────────────────────────

model Tool {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  category     String? // form, calculator, tracker, report, automation, other
  toolUrl      String?
  toolType     String   @default("internal") // internal, external, embedded
