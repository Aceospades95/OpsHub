// ─── POLYMORPHIC ATTACHMENTS ─────────────────────────────

model File {
  id                 String   @id @default(cuid())
  name               String
  url                String
  size               Int?
  mimeType           String?
  source             String   @default("upload")
  // Storage-layer fields. When set, this file was uploaded through
  // src/lib/storage/ and can be served via /api/files/{id}. Legacy rows
  // have these fields null and store an external url directly.
  storageDriver      String? // "local", "s3", etc
  storageKey         String?  @unique
  visibility         String   @default("private") // "public" | "private"
  uploadedById       String
  projectId          String?
  contractId         String?
  documentId         String?
  supplierId         String?
  intranetResourceId String?
  createdAt          DateTime @default(now())

  certificationId String?
  userId          String?
  subcontractorId String?
  partnershipId   String?
  bidOpportunityId String?
  /// Vehicle attachments — maintenance receipts/photos and registration
  /// docs, listed on the fleet vehicle page (category "receipt").
  vehicleId       String?
  // Optional freeform tag used by the employee files UI (resume, id,
  // certification, training, other). Null for files attached to other
  // entities.
  category        String?

  uploadedBy       User              @relation("FileUploader", fields: [uploadedById], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  contract         Contract?         @relation(fields: [contractId], references: [id])
  document         Document?         @relation(fields: [documentId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  intranetResource IntranetResource? @relation(fields: [intranetResourceId], references: [id])
  certification    Certification?    @relation(fields: [certificationId], references: [id])
  user             User?             @relation("FileOwner", fields: [userId], references: [id], onDelete: SetNull)
  subcontractor    Subcontractor?    @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  partnership      Partnership?      @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  bidOpportunity   BidOpportunity?   @relation(fields: [bidOpportunityId], references: [id], onDelete: Cascade)
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  quotes            Quote[]            @relation("QuotePdf")
  workflowDocuments WorkflowDocument[]

  @@index([storageDriver])
  @@index([uploadedById])
  @@index([userId])
  // Supplier receipts list on the supplier detail page filters by both.
  @@index([supplierId, category])
  @@index([bidOpportunityId])
  @@index([vehicleId, category])
