generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  DEVELOPER
  CONTRIBUTOR
  VIEWER
  GUEST
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
  RENEWED
}

enum ContractType {
  MSA
  SOW
  NDA
  Amendment
  Other
}

enum TermType {
  SLA
  OBLIGATION
  DEADLINE
  DELIVERABLE
  ESCALATION
  RENEWAL
  BILLING
  PENALTY
  OTHER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum DocumentType {
  SOP
  GUIDE
  POLICY
  REFERENCE
  TEMPLATE
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum CertificationStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  PENDING
  SUSPENDED
  REVOKED
}

enum CertificationType {
  INDUSTRY
  COMPLIANCE
  SAFETY
  PROFESSIONAL
  QUALITY
  SECURITY
  ENVIRONMENTAL
  VENDOR
  OTHER
}

enum JurisdictionLevel {
  FEDERAL
  STATE
  COUNTY
  CITY
  AGENCY
  PRIVATE
  OTHER
}

enum CertEngagementType {
  SUBSCRIPTION
  CERTIFICATION
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum IntranetCategory {
  EXPENSE_REPORT
  TIME_OFF
  ORG_CHART
  ANNOUNCEMENT
  HR_POLICY
  SOP
  GENERAL_RESOURCE
  FORM
  OTHER
}

enum EmbedType {
  iframe
  google_form
  jotform
  other
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  REVISED
}

enum QuoteDiscountType {
  NONE
  PERCENT
  FIXED
}

enum QuoteRecurringInterval {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

// ─── USERS ───────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String?
  authProvider   String   @default("credentials") // "credentials" | "google"
  role           Role     @default(VIEWER)
  /// Non-null when the user's role was auto-promoted by being assigned to a
  /// project. Stores the role they had before promotion so they can be
  /// reverted if they lose all their assignments.
  promotedFromRole Role?
  avatar         String?
  isActive       Boolean  @default(true)
  hasLoginAccess Boolean  @default(true)
  department     String?
  jobTitle       String?
  location       String?
  phone          String?
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manager        User?    @relation("UserManager", fields: [managerId], references: [id])
  directReports  User[]   @relation("UserManager")

  projectMembers       ProjectMember[]
  milestoneAssignments MilestoneAssignee[]
  comments             Comment[]
  activityLogs         ActivityLog[]
  uploadedFiles        File[]             @relation("FileUploader")
  profileFiles         File[]             @relation("FileOwner")
  modulePermissions    ModulePermission[]
  entityPermissions    EntityPermission[]
  assignedTasks        Task[]             @relation("TaskAssignee")
  createdTasks         Task[]             @relation("TaskCreator")
  sandboxPages         SandboxPage[]
  managedClients       Client[]           @relation("ClientAccountManager")
  customWidgets        CustomWidget[]
  assignedCerts        Certification[]    @relation("CertificationAssignee")
  pocCerts             Certification[]    @relation("CertificationPointOfContact")
  signedOffCerts       Certification[]    @relation("CertificationSignedOffBy")
  certChecklistCompletions CertificationRenewalChecklistItem[] @relation("ChecklistItemCompletedBy")
  certRenewalHistorySignoffs CertificationRenewalHistory[]     @relation("RenewalHistorySignedOffBy")
  assignments          Assignment[]
  notificationsReceived Notification[]    @relation("NotificationRecipient")
  notificationsSent     Notification[]    @relation("NotificationActor")
  accessRequestsMade    AccessRequest[]   @relation("AccessRequestRequester")
  accessRequestsReviewed AccessRequest[]  @relation("AccessRequestReviewer")
  createdQuotes         Quote[]           @relation("QuoteCreator")
  assignedQuotes        Quote[]           @relation("QuoteAssignee")
  createdQuoteTemplates QuoteTemplate[]   @relation("QuoteTemplateCreator")
}

model ModulePermission {
  id         String  @id @default(cuid())
  userId     String
  module     String  // clients, projects, contracts, suppliers, tools, intranet, admin
  canView    Boolean @default(false)
  canEdit    Boolean @default(false)
  canCreate  Boolean @default(false)
  canDelete  Boolean @default(false)
  canComment Boolean @default(false)
  canUpload  Boolean @default(false)
  canManage  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
}

model EntityPermission {
  id         String  @id @default(cuid())
  userId     String
  entityType String  // client, project
  entityId   String
  canView    Boolean @default(false)
  canEdit    Boolean @default(false)
  canComment Boolean @default(false)
  canUpload  Boolean @default(false)
  canManage  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
}

// ─── TASKS ──────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int        @default(0)
  projectId   String?
  clientId    String?
  assigneeId  String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User     @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId])
  @@index([projectId])
  @@index([clientId])
  @@index([status])
}

// ─── CLIENTS ─────────────────────────────────────────────

model Client {
  id               String       @id @default(cuid())
  name             String
  description      String?      @db.Text
  summary          String?      @db.Text
  industry         String?
  website          String?
  status           ClientStatus @default(ACTIVE)
  accountManagerId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  accountManager User?          @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  projects       Project[]
  contracts      Contract[]
  certifications Certification[]
  contacts       ClientContact[]
  comments       Comment[]
  tasks          Task[]
  sandboxPages   SandboxPage[]
  assignments    Assignment[]
  activityLogs   ActivityLog[]
  quotes         Quote[]
}

model ClientContact {
  id        String   @id @default(cuid())
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  notes     String?  @db.Text
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─── PROJECTS ────────────────────────────────────────────

model Project {
  id                String        @id @default(cuid())
  name              String
  description       String?       @db.Text
  status            ProjectStatus @default(PLANNING)
  startDate         DateTime?
  endDate           DateTime?
  clientId          String
  parentProjectId   String?
  serviceOfferingId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  parentProject   Project?         @relation("ProjectHierarchy", fields: [parentProjectId], references: [id])
  childProjects   Project[]        @relation("ProjectHierarchy")
  serviceOffering ServiceOffering? @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)

  contracts  Contract[]
  documents  Document[]
  files      File[]
  comments   Comment[]
  members    ProjectMember[]
  milestones Milestone[]
  links      ExternalLink[]
  embeds     Embed[]
  tools      ProjectTool[]
  tasks        Task[]
  sandboxPages SandboxPage[]

  relations        ProjectRelation[] @relation("ProjectRelations")
  relatedRelations ProjectRelation[] @relation("RelatedProjectRelations")
  assignments      Assignment[]
  projectRoles     ProjectRole[]
  activityLogs     ActivityLog[]
  quotes           Quote[]

  @@index([serviceOfferingId])
}

model ProjectRelation {
  id               String   @id @default(cuid())
  projectId        String
  relatedProjectId String
  createdAt        DateTime @default(now())

  project        Project @relation("ProjectRelations", fields: [projectId], references: [id], onDelete: Cascade)
  relatedProject Project @relation("RelatedProjectRelations", fields: [relatedProjectId], references: [id], onDelete: Cascade)

  @@unique([projectId, relatedProjectId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      Role     @default(CONTRIBUTOR)
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  projectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees MilestoneAssignee[]
}

model MilestoneAssignee {
  id          String   @id @default(cuid())
  milestoneId String
  userId      String
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, userId])
}

// ─── CONTRACTS ───────────────────────────────────────────

model Contract {
  id                  String         @id @default(cuid())
  title               String
  description         String?        @db.Text
  status              ContractStatus @default(DRAFT)
  contractNumber      String?
  contractType        ContractType?
  value               Float?
  currency            String?        @default("USD")
  startDate           DateTime?
  endDate             DateTime?
  renewalDate         DateTime?
  noticePeriodDays    Int?
  autoRenew           Boolean        @default(false)
  summary             String?        @db.Text
  externalDocumentUrl String?
  documentSourceType  String?        // upload, google_drive, external_url, other
  documentSourceLabel String?
  parentContractId    String?
  clientId            String
  projectId           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  parentContract Contract?  @relation("ContractHierarchy", fields: [parentContractId], references: [id])
  childContracts Contract[] @relation("ContractHierarchy")
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project?   @relation(fields: [projectId], references: [id])

  terms    ContractTerm[]
  files    File[]
  comments Comment[]
  links    ExternalLink[]
  embeds   Embed[]
}

model ContractTerm {
  id          String    @id @default(cuid())
  type        TermType  @default(OTHER)
  title       String
  description String    @db.Text
  priority    Priority? @default(MEDIUM)
  dueDate     DateTime?
  contractId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// ─── DOCUMENTS ───────────────────────────────────────────

model Document {
  id        String       @id @default(cuid())
  title     String
  content   String?      @db.Text
  type      DocumentType @default(OTHER)
  version   Int          @default(1)
  published Boolean      @default(false)
  projectId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project  Project?          @relation(fields: [projectId], references: [id])
  versions DocumentVersion[]
  files    File[]
  comments Comment[]
  embeds   Embed[]
}

model DocumentVersion {
  id         String   @id @default(cuid())
  version    Int
  content    String   @db.Text
  changelog  String?  @db.Text
  documentId String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ─── SUPPLIERS ───────────────────────────────────────────

model Supplier {
  id           String         @id @default(cuid())
  name         String
  category     String
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?        @db.Text
  website      String?
  notes        String?        @db.Text
  status       SupplierStatus @default(ACTIVE)
  isPreferred  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  files    File[]
  links    ExternalLink[]
  comments Comment[]
  projects SupplierProject[]
}

model SupplierProject {
  id         String   @id @default(cuid())
  supplierId String
  projectId  String
  notes      String?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, projectId])
}

// ─── TOOLS ───────────────────────────────────────────────

model Tool {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  category     String?  // form, calculator, tracker, report, automation, other
  toolUrl      String?
  toolType     String   @default("internal") // internal, external, embedded
  isGlobal     Boolean  @default(true)
  clonedFromId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clonedFrom Tool?  @relation("ToolClone", fields: [clonedFromId], references: [id])
  clones     Tool[] @relation("ToolClone")

  embeds   Embed[]
  projects ProjectTool[]
}

model ProjectTool {
  id        String   @id @default(cuid())
  projectId String
  toolId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tool    Tool    @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([projectId, toolId])
}

// ─── INTRANET ────────────────────────────────────────────

model IntranetResource {
  id        String           @id @default(cuid())
  title     String
  description String?        @db.Text
  content   String?          @db.Text
  category  IntranetCategory @default(OTHER)
  published Boolean          @default(false)
  pinned    Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  files  File[]
  links  ExternalLink[]
  embeds Embed[]
}

// ─── POLYMORPHIC ATTACHMENTS ─────────────────────────────

model File {
  id                 String   @id @default(cuid())
  name               String
  url                String
  size               Int?
  mimeType           String?
  source             String   @default("upload")
  // Storage-layer fields. When set, this file was uploaded through
  // src/lib/storage/ and can be served via /api/files/{id}. Legacy rows
  // have these fields null and store an external url directly.
  storageDriver      String?  // "local", "s3", etc
  storageKey         String?  @unique
  visibility         String   @default("private") // "public" | "private"
  uploadedById       String
  projectId          String?
  contractId         String?
  documentId         String?
  supplierId         String?
  intranetResourceId String?
  createdAt          DateTime @default(now())

  certificationId  String?
  userId           String?
  // Optional freeform tag used by the employee files UI (resume, id,
  // certification, training, other). Null for files attached to other
  // entities.
  category         String?

  uploadedBy       User              @relation("FileUploader", fields: [uploadedById], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  contract         Contract?         @relation(fields: [contractId], references: [id])
  document         Document?         @relation(fields: [documentId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  intranetResource IntranetResource? @relation(fields: [intranetResourceId], references: [id])
  certification    Certification?    @relation(fields: [certificationId], references: [id])
  user             User?             @relation("FileOwner", fields: [userId], references: [id], onDelete: SetNull)

  quotes Quote[] @relation("QuotePdf")

  @@index([storageDriver])
  @@index([uploadedById])
  @@index([userId])
}

model ExternalLink {
  id                 String   @id @default(cuid())
  title              String
  url                String
  description        String?
  source             String   @default("manual")
  projectId          String?
  contractId         String?
  supplierId         String?
  intranetResourceId String?
  createdAt          DateTime @default(now())

  certificationId  String?

  project          Project?          @relation(fields: [projectId], references: [id])
  contract         Contract?         @relation(fields: [contractId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  intranetResource IntranetResource? @relation(fields: [intranetResourceId], references: [id])
  certification    Certification?    @relation(fields: [certificationId], references: [id])
}

model Embed {
  id                 String    @id @default(cuid())
  title              String
  embedUrl           String    @db.Text
  embedType          EmbedType @default(iframe)
  description        String?
  width              String?   @default("100%")
  height             String?   @default("600px")
  projectId          String?
  contractId         String?
  documentId         String?
  toolId             String?
  intranetResourceId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project          Project?          @relation(fields: [projectId], references: [id])
  contract         Contract?         @relation(fields: [contractId], references: [id])
  document         Document?         @relation(fields: [documentId], references: [id])
  certificationId  String?

  tool             Tool?             @relation(fields: [toolId], references: [id])
  intranetResource IntranetResource? @relation(fields: [intranetResourceId], references: [id])
  certification    Certification?    @relation(fields: [certificationId], references: [id])
}

model Comment {
  id              String   @id @default(cuid())
  content         String   @db.Text
  authorId        String
  clientId        String?
  projectId       String?
  contractId      String?
  documentId      String?
  supplierId      String?
  certificationId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author        User           @relation(fields: [authorId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  project       Project?       @relation(fields: [projectId], references: [id])
  contract      Contract?      @relation(fields: [contractId], references: [id])
  document      Document?      @relation(fields: [documentId], references: [id])
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  certification Certification? @relation(fields: [certificationId], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String   // created, updated, deleted, commented
  entityType String
  entityId   String
  details    String?  @db.Text
  userId     String
  /// Optional scope: project this change relates to, when one applies.
  /// Lets the audit page filter "all changes in project X" without
  /// walking each entity. Nullable because most logs (theme, sandbox,
  /// user account) have no project context.
  projectId  String?
  /// Optional scope: client this change relates to, when one applies.
  clientId   String?
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([projectId])
  @@index([clientId])
  @@index([createdAt])
}

// ─── THEME SETTINGS ─────────────────────────────────────

model ThemeSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── SANDBOX PAGES ──────────────────────────────────────

model SandboxPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  content     String?  @db.Text
  layout      String   @default("default") // default, wide, full
  /** Lucide icon name (e.g., "FileText", "BookOpen"). Resolved at render
      time via the icon picker's IconMap. Null = use the default. */
  icon        String?
  published   Boolean  @default(false)
  createdById String
  projectId   String?
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User     @relation(fields: [createdById], references: [id])
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

// ─── CERTIFICATIONS ────────────────────────────────────

model Certification {
  id                  String              @id @default(cuid())
  name                String
  description         String?             @db.Text
  plainEnglishSummary String?             @db.Text // Layman explanation of what this cert is
  certNumber          String?
  status              CertificationStatus @default(PENDING)
  type                CertificationType   @default(OTHER)
  engagementType      CertEngagementType  @default(CERTIFICATION)
  jurisdictionLevel   JurisdictionLevel   @default(OTHER)
  jurisdictionName    String?             // e.g. "Illinois", "Cook County"
  issuingBody         String?             // Who issued it (e.g., "ISO", "OSHA")
  agencyWebsiteUrl    String?             // Link to the issuing body's website
  agencyContactName   String?
  agencyContactEmail  String?
  agencyContactPhone  String?
  issuedDate          DateTime?
  submittedDate       DateTime?           // When the application was submitted
  expirationDate      DateTime?
  renewalDate         DateTime?           // When to start renewal process
  renewalLeadDays     Int?                @default(90) // Legacy single lead — kept for back-compat
  reminderOffsetsDays Int[]               @default([90, 30, 7]) // Multi-tier reminder offsets
  firedReminderOffsets Int[]              @default([]) // Offsets already fired for the current cycle
  autoRenew           Boolean             @default(false)
  renewalCost         Float?
  currency            String?             @default("USD")
  renewalRequirements String?             @db.Text // What's needed for renewal
  renewalNotes        String?             @db.Text
  documentUrl         String?             // Link to cert document (legacy)
  completedCertUrl    String?             // Link to the finished/issued certificate
  clientId            String?
  assigneeId          String?             // Person currently owning the renewal task
  pointOfContactId    String?             // Long-term internal owner (separate from assignee)
  signedOffAt         DateTime?
  signedOffById       String?
  signOffNotes        String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  client         Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee       User?   @relation("CertificationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  pointOfContact User?   @relation("CertificationPointOfContact", fields: [pointOfContactId], references: [id], onDelete: SetNull)
  signedOffBy    User?   @relation("CertificationSignedOffBy", fields: [signedOffById], references: [id], onDelete: SetNull)

  files           File[]
  comments        Comment[]
  links           ExternalLink[]
  embeds          Embed[]
  checklistItems  CertificationRenewalChecklistItem[]
  renewalHistory  CertificationRenewalHistory[]
}

model CertificationRenewalChecklistItem {
  id              String   @id @default(cuid())
  certificationId String
  label           String
  required        Boolean  @default(false)
  completed       Boolean  @default(false)
  completedAt     DateTime?
  completedById   String?
  sortOrder       Int      @default(0)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  completedBy   User?         @relation("ChecklistItemCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([certificationId, sortOrder])
}

model CertificationRenewalHistory {
  id              String    @id @default(cuid())
  certificationId String
  cycleStart      DateTime?
  cycleEnd        DateTime?
  issuedDate      DateTime?
  expiredDate     DateTime?
  signedOffById   String?
  signedOffAt     DateTime?
  cost            Float?
  currency        String?   @default("USD")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  signedOffBy   User?         @relation("RenewalHistorySignedOffBy", fields: [signedOffById], references: [id], onDelete: SetNull)

  @@index([certificationId, createdAt])
}

// ─── SERVICE OFFERINGS ─────────────────────────────────

model ServiceOffering {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments Assignment[]
  projects    Project[]
}

// ─── ROLE DEFINITIONS ─────────────────────────────────

model RoleDefinition {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectRoles ProjectRole[]
  assignments  Assignment[]
}

// ─── PROJECT ROLES (Staffing Requirements) ───────────

model ProjectRole {
  id               String   @id @default(cuid())
  projectId        String
  roleDefinitionId String
  requiredFte      Float    @default(1.0)
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleDefinition RoleDefinition @relation(fields: [roleDefinitionId], references: [id])
  assignments    Assignment[]

  @@index([projectId])
  @@index([roleDefinitionId])
}

// ─── ASSIGNMENTS / ALLOCATIONS ─────────────────────────

enum AssignmentStatus {
  ACTIVE
  PLANNED
  COMPLETED
  ON_HOLD
}

model Assignment {
  id                String           @id @default(cuid())
  employeeId        String
  projectId         String?
  clientId          String?
  serviceOfferingId String?
  projectRoleId     String?
  roleDefinitionId  String?
  function          String?          // work type / functional area
  role              String?          // legacy freeform role — prefer roleDefinition
  allocationFte     Float            @default(0)
  status            AssignmentStatus @default(ACTIVE)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  employee        User              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  serviceOffering ServiceOffering?  @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)
  projectRole     ProjectRole?      @relation(fields: [projectRoleId], references: [id], onDelete: SetNull)
  roleDefinition  RoleDefinition?   @relation(fields: [roleDefinitionId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([projectId])
  @@index([clientId])
  @@index([serviceOfferingId])
  @@index([projectRoleId])
  @@index([roleDefinitionId])
  @@index([status])
}

// ─── DATA IMPORTS ──────────────────────────────────────
//
// Audit log for CSV imports through src/lib/importers/. Each row records
// one import run — what was uploaded, who did it, how many rows were
// created vs skipped, and any per-row error messages.

model ImportLog {
  id          String   @id @default(cuid())
  importerKey String   // matches a key in the importer registry
  filename    String
  rowCount    Int      // total parsed rows
  imported    Int      // successfully created
  skipped     Int      // skipped (duplicates, dry-run, etc.)
  /** JSON array of { row, message } error entries */
  errors      String?  @db.Text
  triggeredBy String   // user id
  createdAt   DateTime @default(now())

  @@index([importerKey, createdAt])
  @@index([createdAt])
  @@index([triggeredBy])
}

// ─── SCHEDULED JOBS ────────────────────────────────────
//
// Audit log for scheduled job runs. Each row records one execution of a
// job defined in src/lib/jobs/. Jobs can be triggered by the cron endpoint
// (/api/jobs/run) or manually from /admin/jobs.

model JobLog {
  id          String    @id @default(cuid())
  jobKey      String    // matches a key in the job registry
  status      String    // "running" | "completed" | "failed"
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  /** Free-form summary string the job handler returns */
  output      String?   @db.Text
  /** Stack/message when status = "failed" */
  error       String?   @db.Text
  /** Number of items the job processed (for at-a-glance metrics) */
  processed   Int?
  /** "cron" for scheduled runs, or a user id for manual runs */
  triggeredBy String

  @@index([jobKey, startedAt])
  @@index([startedAt])
  @@index([status])
}

// ─── NOTIFICATIONS ─────────────────────────────────────
//
// In-app notification for a user. Written by src/lib/notifications/notify().
// Optionally paired with an outbound email — that's handled by notify()
// itself which delegates to the email layer after writing the row.

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  /** Free-form type key for filtering/grouping — see NotificationType in code */
  type        String
  title       String
  body        String?   @db.Text
  /** Where clicking the notification should navigate */
  href        String?
  /** Optional entity this notification is about, for context and routing */
  entityType  String?
  entityId    String?
  /** Who triggered this (null for system notifications) */
  actorId     String?
  /** Read timestamp — null means unread */
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([entityType, entityId])
  @@index([type])
}

// ─── EMAIL LOG ─────────────────────────────────────────
//
// Every outbound email routed through src/lib/email/ lands here for audit
// and debugging. In dev the "log" driver ONLY writes to this table and
// doesn't actually send, so it's safe to test templates without spamming.

model EmailLog {
  id          String   @id @default(cuid())
  toAddresses String   // comma-separated recipient list
  fromAddress String
  subject     String
  bodyHtml    String   @db.Text
  bodyText    String?  @db.Text
  driver      String   // which driver handled send: "log", "resend", etc
  status      String   // "sent" | "failed" | "queued"
  messageId   String?  // provider's message ID when available
  error       String?  @db.Text
  templateKey String?  // which template was used
  entityType  String?  // optional audit: entity this email is about
  entityId    String?
  sentAt      DateTime @default(now())

  @@index([sentAt])
  @@index([status])
  @@index([templateKey])
  @@index([entityType, entityId])
}

// ─── CUSTOM WIDGETS ────────────────────────────────────

model CustomWidget {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  config      String   @db.Text             // JSON WidgetConfig
  icon        String?  @default("BarChart3")
  category    String   @default("data")
  isPublished Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([isPublished])
}

// ─── SSO ALLOWED DOMAINS ──────────────────────────────
//
// Admin-managed allowlist of email domains permitted to sign in
// via Google SSO. If no rows exist, all Google domains are allowed.

model AllowedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique // e.g. "company.com"
  createdAt DateTime @default(now())
}

// ─── ACCESS REQUESTS ─────────────────────────────────────

model AccessRequest {
  id           String   @id @default(cuid())
  requesterId  String
  module       String?
  entityType   String?
  entityId     String?
  entityLabel  String?
  status       String   @default("PENDING") // PENDING, APPROVED, DENIED
  reviewerId   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  requester User  @relation("AccessRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("AccessRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requesterId])
}

// ─── QUOTES ─────────────────────────────────────────────
//
// Sales quote / proposal builder. A Quote belongs to a Client and optionally
// to a Project. Line items can be reusable CatalogItem references or one-off
// custom rows. Quotes can be revised — a revision links back to the parent
// via parentQuoteId and the parent transitions to REVISED.
//
// Phase 1 covers: draft authoring, line items, totals, templates, catalog.
// Phases 2+ wire up sending, public token view, accept/reject, e-sig, PDF.

model Quote {
  id                    String      @id @default(cuid())
  /// Human-readable identifier auto-generated on create (e.g. "Q-2026-0001").
  /// Unique across the org. Format is fixed; renumbering would invalidate
  /// the URL the client received in their email.
  quoteNumber           String      @unique
  clientId              String
  projectId             String?
  status                QuoteStatus @default(DRAFT)
  title                 String
  /// Markdown-friendly intro text rendered above the line items on the
  /// public view. Optional.
  introText             String?     @db.Text
  /// Footer / terms & conditions text rendered below the totals on the
  /// public view. Optional.
  termsText             String?     @db.Text
  currency              String      @default("USD")
  /// Cached subtotal of all line items (after per-line discounts, before
  /// quote-level discount and tax). Recomputed on every save.
  subtotal              Float       @default(0)
  discountType          QuoteDiscountType @default(NONE)
  discountValue         Float       @default(0)
  /// Tax rate as a percentage. Nullable so tax-exempt quotes can render
  /// cleanly without a 0% line on the public view.
  taxRate               Float?
  taxAmount             Float       @default(0)
  total                 Float       @default(0)
  validUntil            DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  sentAt                DateTime?
  firstViewedAt         DateTime?
  acceptedSignatureName String?
  acceptedSignatureData String?     @db.Text
  acceptedIp            String?
  rejectionReason       String?     @db.Text
  /// Links a revision to the prior version. The parent transitions to
  /// REVISED when a child is created.
  parentQuoteId         String?
  createdById           String
  assignedToId          String?
  /// Owner-only notes — never rendered on the client-facing public view.
  internalNotes         String?     @db.Text
  /// Cryptographically random token used in the public share URL `/q/:token`.
  /// Set when the quote is first sent. Nullable on drafts.
  publicToken           String?     @unique
  /// File reference to the most recently generated PDF. Regenerated on
  /// edit so consumers can rely on `pdfFile.url` being current.
  pdfFileId             String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentQuote  Quote?   @relation("QuoteRevisions", fields: [parentQuoteId], references: [id])
  revisions    Quote[]  @relation("QuoteRevisions")
  createdBy    User     @relation("QuoteCreator", fields: [createdById], references: [id])
  assignedTo   User?    @relation("QuoteAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  pdfFile      File?    @relation("QuotePdf", fields: [pdfFileId], references: [id], onDelete: SetNull)

  lineItems QuoteLineItem[]
  events    QuoteEvent[]

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([validUntil])
}

model QuoteLineItem {
  id                String                  @id @default(cuid())
  quoteId           String
  position          Int                     @default(0)
  /// Optional grouping label rendered as a section divider on the public
  /// view (e.g. "Hardware", "Services", "Optional Add-ons").
  groupLabel        String?
  /// When true, the client can toggle this row on/off on the public quote
  /// page. The total recalculates as they toggle.
  isOptional        Boolean                 @default(false)
  /// Whether this optional row is currently selected. Always true for
  /// non-optional rows. The client mutates this on accept.
  isSelected        Boolean                 @default(true)
  catalogItemId     String?
  name              String
  description       String?                 @db.Text
  quantity          Float                   @default(1)
  unit              String?
  unitPrice         Float                   @default(0)
  discountType      QuoteDiscountType       @default(NONE)
  discountValue     Float                   @default(0)
  isRecurring       Boolean                 @default(false)
  recurringInterval QuoteRecurringInterval?
  /// Cached row subtotal (qty * unitPrice, after this row's discount).
  subtotal          Float                   @default(0)

  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([quoteId, position])
}

// Reusable service / product catalog. Powers line-item autocomplete in the
// quote editor — typing in a row's name field pulls suggestions from here.
// Catalog items are global; per-line edits don't write back to the catalog.
model CatalogItem {
  id               String   @id @default(cuid())
  name             String
  description      String?  @db.Text
  defaultUnitPrice Float    @default(0)
  defaultUnit      String?
  category         String?
  isRecurring      Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quoteLineItems    QuoteLineItem[]
  templateLineItems QuoteTemplateLineItem[]

  @@index([isActive])
  @@index([category])
}

// Saved quote shapes used as the starting point for new quotes. A template
// has the same shape as a Quote minus per-quote fields (client, dates,
// signatures, etc.). Creating a quote from a template clones the line items.
model QuoteTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  introText   String?  @db.Text
  termsText   String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("QuoteTemplateCreator", fields: [createdById], references: [id])

  lineItems QuoteTemplateLineItem[]
}

model QuoteTemplateLineItem {
  id                String                  @id @default(cuid())
  templateId        String
  position          Int                     @default(0)
  groupLabel        String?
  isOptional        Boolean                 @default(false)
  catalogItemId     String?
  name              String
  description       String?                 @db.Text
  quantity          Float                   @default(1)
  unit              String?
  unitPrice         Float                   @default(0)
  discountType      QuoteDiscountType       @default(NONE)
  discountValue     Float                   @default(0)
  isRecurring       Boolean                 @default(false)
  recurringInterval QuoteRecurringInterval?

  template    QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([templateId, position])
}

// Audit / activity log for a single quote. Distinct from the global
// ActivityLog because public actors (clients viewing/accepting) are not
// User rows and we want richer per-event metadata.
model QuoteEvent {
  id        String   @id @default(cuid())
  quoteId   String
  /// One of: created, sent, viewed, downloaded, accepted, rejected,
  /// revised, edited, comment_added. Stored as a string so adding a new
  /// event type doesn't require a migration.
  eventType String
  /// "user" | "client" | "system"
  actorType String
  /// User id when actorType="user". Null for client and system actors.
  actorId   String?
  /// Free-form JSON payload for event-specific data.
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}
